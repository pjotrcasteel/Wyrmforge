@using Wyrmforge.Application.Abstractions.Randomness
@using Wyrmforge.Application.Runs.SelfPlay
@using Wyrmforge.Application.Runs.Simulation
@using Wyrmforge.Application.Runs.Development
@using Wyrmforge.Application.Runs.Hunts
@using Wyrmforge.Domain.Combat.Dragons
@using Wyrmforge.Domain.Combat.Geometry
@using Wyrmforge.Domain.Spells

<main class="balance-lab">
    <header class="lab-header">
        <div>
            <div class="eyebrow">WYRMFORGE • BALANCE LAB</div>
            <h1>Let the game play itself.</h1>
            <p>Run the real deterministic simulation with a visible player heuristic. This is measurement equipment, not an automatic balance oracle.</p>
        </div>
        <div class="header-actions">
            <button class="secondary" @onclick="OpenCombatLab">Combat Lab</button>
            <button class="secondary" @onclick="BackToForge">← Forge</button>
        </div>
    </header>

    <section class="hunt-trial-panel" aria-label="Developer hunt trials">
        <header class="hunt-trial-heading">
            <div>
                <span class="eyebrow">ASCENDANT ENCOUNTER TEST BENCH</span>
                <h2>Skip the grind. Stress-test the Wyrm.</h2>
                <p>Start directly at Depth II with a Rank III evolved spell. No saves, Forge unlocks or Great Hunt trophies are modified. The agent plays the real combat simulation, including boss entrances, phases and damage.</p>
            </div>
            <strong>ISOLATED DEV MODE</strong>
        </header>
        <div class="hunt-trial-controls">
            <label>Wyrm
                <select @bind="huntWyrm" aria-label="Test Wyrm">
                    @foreach (var wyrm in DragonCatalog.All)
                    {
                        <option value="@wyrm.Id">@wyrm.Name</option>
                    }
                </select>
            </label>
            <label>Encounter
                <select @bind="huntVariant" aria-label="Encounter variant">
                    <option value="false">Ordinary</option>
                    @if (AscendantRiteCatalog.IsAvailable(huntWyrm))
                    {
                        <option value="true">Ascendant</option>
                    }
                </select>
            </label>
            <label>Start phase
                <select @bind="huntPhase" aria-label="Starting boss phase">
                    <option value="1">Phase I · entrance</option>
                    <option value="2">Phase II · break</option>
                </select>
            </label>
            <label>Inspect geometry
                <select @bind="portraitPreview" aria-label="Preview orientation">
                    <option value="true">Portrait · 390 × 844</option>
                    <option value="false">Landscape · 844 × 390</option>
                </select>
            </label>
            <label class="hunt-trial-practice">
                <input type="checkbox" @bind="huntInvulnerable" />
                Invulnerable practice (not valid for fairness scores)
            </label>
            <button class="primary" disabled="@huntRunning" @onclick="RunHuntTrialsAsync">@(huntRunning ? $"SIMULATING {huntProgress}/2…" : "RUN PORTRAIT + LANDSCAPE TRIALS")</button>
        </div>
        <div class="hunt-trial-layout">
            <div class="hunt-pattern">
                <div class="hunt-pattern-heading"><strong>@PreviewProfile.Signature.Name · phase @huntPhase</strong><small>Deterministic warning geometry · @PreviewWidth × @PreviewHeight</small></div>
                <svg class="hunt-pattern-arena" viewBox="@($"0 0 {PreviewWidth} {PreviewHeight}")" role="img" aria-label="Planned boss warning positions with player centered">
                    <rect x="1" y="1" width="@(PreviewWidth - 2)" height="@(PreviewHeight - 2)" rx="16" fill="#101020" stroke="#504465" stroke-width="2" />
                    @foreach (var strike in PreviewStrikes)
                    {
                        <circle cx="@strike.Position.X" cy="@strike.Position.Y" r="@(strike.Radius ?? PreviewProfile.Signature.Radius.For(huntPhase))"
                            class="hunt-strike @(strike.DelaySeconds == 0 ? "first" : "later")" />
                    }
                    <circle cx="@(PreviewWidth / 2d)" cy="@(PreviewHeight / 2d)" r="12" fill="#e8d5ff" stroke="#ab78da" stroke-width="4" />
                </svg>
                <small>Preview shows planned strike locations, not the full cinematic renderer. Actual attack timing and damage are measured below.</small>
            </div>
            <div class="hunt-trial-results" aria-live="polite">
                @if (huntResults.Count == 0)
                {
                    <div class="hunt-trial-empty">Choose an encounter, then let the agent attempt it in both mobile orientations. The previews and tests never count toward your player progression.</div>
                }
                else
                {
                    <div class="hunt-trial-summary">
                        <article><span>VICTORIES</span><strong>@huntResults.Count(x => x.Victory) / @huntResults.Count</strong></article>
                        <article><span>PHASE II REACHED</span><strong>@huntResults.Count(x => x.ReachedSecondPhase) / @huntResults.Count</strong></article>
                        <article><span>AVG DAMAGE</span><strong>@huntResults.Average(x => x.DamageTaken).ToString("0")</strong></article>
                        <article><span>WARNING FRAMES</span><strong>@huntResults.Sum(x => x.SignatureWarningFrames)</strong></article>
                    </div>
                    @foreach (var trial in huntResults)
                    {
                        <article class="hunt-trial-row">
                            <div><strong>@(trial.Setup.Width < trial.Setup.Height ? "PORTRAIT" : "LANDSCAPE") · seed @trial.Setup.Seed</strong>
                                <span>@(trial.Victory ? "Wyrm defeated" : trial.Defeated ? "Agent defeated" : "Time limit") · @trial.DurationSeconds.ToString("0.0")s · @trial.Agent</span></div>
                            <div><strong>HP @trial.HealthRemaining.ToString("0") · min @trial.MinimumHealthRatio.ToString("P0")</strong>
                                <span>@trial.SignaturePatternsObserved attack windows · @trial.WarningExposureFrames pre-armed overlaps · @trial.ActiveStrikeExposureFrames armed overlaps</span></div>
                        </article>
                    }
                    <small class="hunt-trial-disclaimer">These are reproducible heuristic-agent trials, not proof that human players find the attacks fair or fun. Real-device cinematic and touch checks remain separate.</small>
                }
            </div>
        </div>
    </section>

    <section class="lab-layout">
        <aside class="control-panel">
            <div class="panel-heading"><div><strong>SELF-PLAY TRIAL</strong><span>Choose a representative Arcane build and agent personality.</span></div></div>

            <label>Build
                <select @bind="selectedBuildIndex">
                    @for (var index = 0; index < SelfPlayBuildCatalog.All.Count; index++)
                    {
                        <option value="@index">@SelfPlayBuildCatalog.All[index].Name • @SelfPlayBuildCatalog.All[index].SpentPoints pts</option>
                    }
                </select>
            </label>

            <label>Agent
                <select @bind="selectedPersonality">
                    @foreach (var personality in Enum.GetValues<RunAgentPersonality>())
                    {
                        <option value="@personality">@personality</option>
                    }
                </select>
            </label>

            <label>Seed
                <input type="number" @bind="seed" />
            </label>

            <button class="primary" disabled="@running" @onclick="RunAsync">@(running ? "SIMULATING…" : "RUN HEADLESS TRIAL")</button>

            <div class="agent-notes">
                <strong>@selectedPersonality</strong>
                <small>@AgentDescription</small>
            </div>
        </aside>

        <section class="results-panel">
            @if (result is null)
            {
                <div class="empty-results">
                    <span>◇</span>
                    <strong>No trial yet</strong>
                    <small>The runner uses real RunSimulation state: movement, route choices, drafts, relics, Wyrm Essence and Refuge decisions.</small>
                </div>
            }
            else
            {
                <div class="result-heading">
                    <div><span>@result.Build • @result.Cohort • @result.SpentArcanePoints pts</span><strong>@result.Agent • seed @result.Seed • @result.StopReason</strong></div>
                    <b>@result.Outcome</b>
                </div>

                <div class="metric-grid">
                    <article><span>DEPTH</span><strong>@result.Depth</strong></article>
                    <article><span>SCORE</span><strong>@result.Score.ToString("N0")</strong></article>
                    <article><span>KILLS / MIN</span><strong>@result.KillsPerMinute.ToString("0.0")</strong></article>
                    <article><span>XP / MIN</span><strong>@result.ExperiencePerMinute.ToString("0.0")</strong></article>
                    <article><span>XP COLLECTED</span><strong>@result.ExperienceCollectionRate.ToString("P0")</strong></article>
                    <article><span>MIN HEALTH</span><strong>@result.MinimumHealthRatio.ToString("P0")</strong></article>
                    <article><span>PEAK ENEMIES</span><strong>@result.PeakEnemies</strong></article>
                    <article><span>LEVEL</span><strong>@result.Level</strong></article>
                    <article><span>ESSENCE</span><strong>@result.EssenceSecured</strong></article>
                    <article><span>WYRM KILLS</span><strong>@result.DragonsSlain</strong></article>
                    <article><span>SYNERGIES</span><strong>@result.Synergies</strong></article>
                    <article><span>RUN TIME</span><strong>@TimeSpan.FromSeconds(result.SimulatedSeconds).ToString(@"m:ss")</strong></article>
                    <article><span>DAMAGE TAKEN</span><strong>@result.DamageTaken.ToString("0")</strong></article>
                </div>

                <section class="decision-log">
                    <span>DECISION TRACE</span>
                    @foreach (var decision in result.Decisions.TakeLast(18))
                    {
                        <code>@decision</code>
                    }
                </section>
            }
        </section>
    </section>
</main>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private DragonId huntWyrm = DragonId.Stormcoil;
    private bool huntVariant = true;
    private int huntPhase = 1;
    private bool portraitPreview = true;
    private bool huntInvulnerable;
    private bool huntRunning;
    private int huntProgress;
    private readonly List<DevelopmentHuntTrialResult> huntResults = [];
    private int selectedBuildIndex;

    private DragonHuntProfile PreviewProfile => huntVariant && AscendantRiteCatalog.IsAvailable(huntWyrm)
        ? DragonHuntCatalog.GetAscendant(huntWyrm) : DragonHuntCatalog.Get(huntWyrm);
    private double PreviewWidth => portraitPreview ? 390 : 844;
    private double PreviewHeight => portraitPreview ? 844 : 390;
    private IReadOnlyList<DragonHuntSignatureStrike> PreviewStrikes => DragonHuntSignaturePlanner.Create(PreviewProfile.Signature, huntPhase,
        new Vector2D(PreviewWidth / 2d, PreviewHeight * 0.2), new Vector2D(PreviewWidth / 2d, PreviewHeight / 2d),
        PreviewWidth, PreviewHeight, new SeededRandomSource(seed));

    private async Task RunHuntTrialsAsync()
    {
        if (huntRunning) return;
        huntRunning = true;
        huntProgress = 0;
        huntResults.Clear();
        var build = SelfPlayBuildCatalog.All[selectedBuildIndex];
        var wyrm = huntWyrm;
        var ascendant = huntVariant && AscendantRiteCatalog.IsAvailable(wyrm);
        var spell = wyrm switch
        {
            DragonId.Ashfang => SpellId.FireBolt,
            DragonId.Stormcoil => SpellId.ChainLightning,
            DragonId.Rimeclaw => SpellId.FrostShard,
            _ => SpellId.ArcaneOrb,
        };

        try
        {
            foreach (var (width, height) in new[] { (390d, 844d), (844d, 390d) })
            {
                await Task.Yield();
                var setup = new DevelopmentHuntSetup(wyrm, ascendant, huntPhase, spell, seed, width, height, huntInvulnerable);
                huntResults.Add(new DevelopmentHuntTrial().Run(build, setup, selectedPersonality));
                huntProgress++;
                await InvokeAsync(StateHasChanged);
            }
        }
        finally { huntRunning = false; }
    }
    private RunAgentPersonality selectedPersonality = RunAgentPersonality.BuildFocused;
    private int seed = 1337;
    private bool running;
    private RunSelfPlayMetrics? result;

    private string AgentDescription => selectedPersonality switch
    {
        RunAgentPersonality.Casual => "Prefers understandable convergence, heals early and usually banks the first secured haul.",
        RunAgentPersonality.Kiter => "Values survival, distance and mobility; descends only while health remains comfortable.",
        RunAgentPersonality.Greedy => "Chases XP, damage and deeper runs; tolerates much lower health before leaving.",
        _ => "Treats the selected Arcane school as intent and strongly prefers rewards that reinforce or converge on it.",
    };

    private async Task RunAsync()
    {
        running = true;
        result = null;
        await Task.Yield();

        var build = SelfPlayBuildCatalog.All[selectedBuildIndex];
        var factory = new RunSimulationFactory(new SeededRandomSource(1));
        var simulation = factory.Create(build.SelectedNodes, seed: seed);
        var agent = new HeuristicRunAgent(selectedPersonality, seed, build.PreferredSchool);
        result = new RunSelfPlayDriver().Play(build, seed, simulation, agent, new RunSelfPlayOptions(MaximumSimulatedSeconds: 480));
        running = false;
    }

    private void OpenCombatLab() => Navigation.NavigateTo("combat-lab");
    private void BackToForge() => Navigation.NavigateTo(string.Empty);
}
