@namespace Wyrmforge.Presentation.Web.Features.RunDecision

<div class="dragon-harvest">
    <section class="dragon-harvest-card">
        <div class="eyebrow">ESSENCE BOUND • AN EXIT OPENS</div>
        <h2>Leave with what you stole, or go deeper.</h2>
        <p>Opening the way out takes four dangerous seconds. Or keep the essence active and descend for greater rewards.</p>
        <div class="essence-choices">
            <button class="essence-choice" @onclick="ExtractAsync">
                <span class="essence-source">EXIT ROUTE</span>
                <span class="essence-icon">◈</span>
                <strong>Begin extraction</strong>
                <span class="essence-effect">Survive a 4-second extraction ritual to secure the harvested essence.</span>
                <small>Combat continues during the ritual. Die before it finishes and the essence is lost.</small>
                <span class="essence-footer">OPEN THE WAY OUT</span>
            </button>
            <button class="essence-choice" @onclick="PushAsync">
                <span class="essence-source">RISK CHOICE</span>
                <span class="essence-icon">▼</span>
                <strong>Descend to Depth @NextDepth</strong>
                <span class="essence-effect">Enemies become tougher, arrive faster, and unstable rifts begin opening beneath you.</span>
                <small>Keep the stolen essence active and earn ×@ScoreMultiplier.ToString("0.0") score from enemy kills. Move out of a rift before its warning ring closes.</small>
                <span class="essence-footer">PUSH DEEPER</span>
            </button>
        </div>
    </section>
</div>

@code {
    [Parameter]
    public int NextDepth { get; set; }

    [Parameter]
    public double ScoreMultiplier { get; set; }

    [Parameter]
    public EventCallback OnExtract { get; set; }

    [Parameter]
    public EventCallback OnPush { get; set; }

    private Task ExtractAsync() => OnExtract.InvokeAsync();

    private Task PushAsync() => OnPush.InvokeAsync();
}
