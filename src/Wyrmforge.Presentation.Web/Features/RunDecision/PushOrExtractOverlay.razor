@namespace Wyrmforge.Presentation.Web.Features.RunDecision

<div class="dragon-harvest">
    <section class="dragon-harvest-card">
        <div class="eyebrow">@(CanPushDeeper ? "EVACUATION COMPLETE • SAFE INTERMISSION" : "EVACUATION COMPLETE • RETURN PASSAGE STABLE")</div>
        <h2>@(CanPushDeeper ? "You made it out. Decide whether the run ends here." : "You made it out. Bring everything home.")</h2>
        <p>@(CanPushDeeper ? "This is a safe checkpoint between dives. For now you can return to the Forge or descend again; later this is where recovery, items and build changes can live." : "No deeper realm is implemented yet. Leave the Wyrmrealm to secure every essence you carried through the evacuation surge.")</p>
        <div class="essence-choices">
            <button class="essence-choice" @onclick="ExtractAsync">
                <span class="essence-source">SAFE EXIT</span>
                <span class="essence-icon">◈</span>
                <strong>Return to the Forge</strong>
                <span class="essence-effect">End the run safely and secure every carried essence.</span>
                <small>The dangerous part is already over. This checkpoint is the clean boundary between one dive and the next.</small>
                <span class="essence-footer">LEAVE WYRMREALM</span>
            </button>
            @if (CanPushDeeper)
            {
                <button class="essence-choice" @onclick="PushAsync">
                    <span class="essence-source">NEXT DIVE</span>
                    <span class="essence-icon">▼</span>
                    <strong>Descend to Depth @NextDepth</strong>
                    <span class="essence-effect">Carry your new essence back into the Wyrmrealm and face tougher enemies, faster pressure and unstable rifts.</span>
                    <small>Enemy kills are worth ×@ScoreMultiplier.ToString("0.0") score. Complete the next objective, hunt another wyrm, then survive another evacuation.</small>
                    <span class="essence-footer">GO BACK IN</span>
                </button>
            }
        </div>
    </section>
</div>

@code {
    [Parameter]
    public bool CanPushDeeper { get; set; }

    [Parameter]
    public int NextDepth { get; set; }

    [Parameter]
    public double ScoreMultiplier { get; set; }

    [Parameter]
    public EventCallback OnExtract { get; set; }

    [Parameter]
    public EventCallback OnPush { get; set; }

    private Task ExtractAsync() => OnExtract.InvokeAsync();

    private Task PushAsync() => OnPush.InvokeAsync();
}
