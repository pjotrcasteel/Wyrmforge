@namespace Wyrmforge.Presentation.Web.Features.Refuge
@using Wyrmforge.Application.Runs.Checkpoint
@using Wyrmforge.Domain.Progression.Relics

<div class="refuge-overlay">
    <section class="refuge-card">
        <div class="refuge-heading">
            <div>
                <div class="eyebrow">THE REFUGE • SAFE CHECKPOINT @Visit</div>
                <h2>The realm cannot reach you here.</h2>
                <p>Restore yourself, reshape your relic loadout, return home with your spoils, or risk another dive.</p>
            </div>
            <div class="refuge-health"><span>VITALITY</span><strong>@Math.Ceiling(Health) / @Math.Ceiling(MaxHealth)</strong><div class="health-track"><i style="@HealthStyle"></i></div></div>
        </div>

        @if (OwnedRelics.Count > 0)
        {
            <section class="relic-loadout">
                <div class="loadout-heading"><strong>RELIC LOADOUT</strong><span>@EquippedRelics.Count / @RelicSlots equipped</span></div>
                <div class="relic-grid">
                    @foreach (var relic in OwnedRelics)
                    {
                        var equipped = EquippedRelics.Any(candidate => candidate.Id == relic.Id);
                        <button class="relic-loadout-item @(equipped ? "equipped" : "stored")" disabled="@(!equipped && EquippedRelics.Count >= RelicSlots)" @onclick="() => ToggleRelicAsync(relic.Id, equipped)">
                            <span class="relic-loadout-icon">@relic.Icon</span>
                            <div><strong>@relic.Name</strong><small>@relic.Description</small></div>
                            <b>@(equipped ? "EQUIPPED" : "IN PACK")</b>
                        </button>
                    }
                </div>
                <small class="loadout-hint">Unequip one relic to free a slot before equipping another.</small>
            </section>
        }

        <div class="refuge-actions">
            @foreach (var action in Actions)
            {
                <button class="@ActionClass(action)" disabled="@(!action.Enabled)" @onclick="() => UseAsync(action.Id)">
                    <span class="refuge-action-kind">@ActionLabel(action)</span><span class="refuge-action-icon">@ActionIcon(action.Id)</span><strong>@ActionTitle(action.Id)</strong>
                    <span class="refuge-action-effect">@ActionEffect(action)</span><small>@ActionDescription(action)</small><span class="refuge-action-footer">@ActionFooter(action)</span>
                </button>
            }
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RunCheckpointActionState> Actions { get; set; } = Array.Empty<RunCheckpointActionState>();
    [Parameter, EditorRequired] public IReadOnlyList<RelicDefinition> OwnedRelics { get; set; } = Array.Empty<RelicDefinition>();
    [Parameter, EditorRequired] public IReadOnlyList<RelicDefinition> EquippedRelics { get; set; } = Array.Empty<RelicDefinition>();
    [Parameter] public int Visit { get; set; }
    [Parameter] public int NextDepth { get; set; }
    [Parameter] public int RelicSlots { get; set; }
    [Parameter] public double ScoreMultiplier { get; set; }
    [Parameter] public double Health { get; set; }
    [Parameter] public double MaxHealth { get; set; }
    [Parameter] public EventCallback<RunCheckpointActionId> OnUse { get; set; }
    [Parameter] public EventCallback<RelicId> OnEquipRelic { get; set; }
    [Parameter] public EventCallback<RelicId> OnUnequipRelic { get; set; }

    private string HealthStyle => $"width:{(MaxHealth <= 0 ? 0 : Math.Clamp(Health / MaxHealth * 100, 0, 100)):0.#}%";
    private Task UseAsync(RunCheckpointActionId id) => OnUse.InvokeAsync(id);
    private Task ToggleRelicAsync(RelicId id, bool equipped) => equipped ? OnUnequipRelic.InvokeAsync(id) : OnEquipRelic.InvokeAsync(id);
    private static string ActionClass(RunCheckpointActionState action) => $"refuge-action action-{action.Id.ToString().ToLowerInvariant()}{(action.Used ? " used" : string.Empty)}";
    private static string ActionLabel(RunCheckpointActionState action) => action.Id switch { RunCheckpointActionId.MendWounds => action.Used ? "RESTED" : "REFUGE SERVICE", RunCheckpointActionId.Descend => action.Enabled ? "NEXT DIVE" : "SEALED PASSAGE", _ => "SAFE EXIT" };
    private static string ActionIcon(RunCheckpointActionId id) => id switch { RunCheckpointActionId.MendWounds => "✚", RunCheckpointActionId.Descend => "▼", _ => "◈" };
    private string ActionTitle(RunCheckpointActionId id) => id switch { RunCheckpointActionId.MendWounds => "Mend wounds", RunCheckpointActionId.Descend => $"Descend to Depth {NextDepth}", _ => "Return to the Forge" };
    private string ActionEffect(RunCheckpointActionState action) => action.Id switch { RunCheckpointActionId.MendWounds when action.Used => "The ward has already restored you during this visit.", RunCheckpointActionId.MendWounds when Health >= MaxHealth => "You are already at full vitality.", RunCheckpointActionId.MendWounds => $"Restore {RunCheckpointState.MendFraction * 100:0}% of maximum vitality.", RunCheckpointActionId.Descend when action.Enabled => $"Enter the next map at ×{ScoreMultiplier:0.0} base depth reward.", RunCheckpointActionId.Descend => "No deeper passage is stable yet.", _ => "End the run safely and secure everything you carried out." };
    private static string ActionDescription(RunCheckpointActionState action) => action.Id switch { RunCheckpointActionId.MendWounds => "The Refuge gathers enough strength to close your wounds once each time you arrive.", RunCheckpointActionId.Descend => "Carry your build and stolen essence into another map with stronger pressure and new route choices.", _ => "The evacuation is complete. Leaving from the Refuge is always safe." };
    private static string ActionFooter(RunCheckpointActionState action) => action.Id switch { RunCheckpointActionId.MendWounds when action.Enabled => "REST AT THE REFUGE", RunCheckpointActionId.MendWounds => "UNAVAILABLE", RunCheckpointActionId.Descend when action.Enabled => "OPEN THE PASSAGE", RunCheckpointActionId.Descend => "MAX DEPTH REACHED", _ => "LEAVE WYRMREALM" };
}
