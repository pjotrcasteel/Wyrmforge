@namespace Wyrmforge.Presentation.Web.Features.Map
@using Wyrmforge.Application.Runs.Navigation
@using Wyrmforge.Domain.Spells

<div class="realm-map-overlay">
    <section class="realm-map-card">
        <div class="eyebrow">WYRMREALM ROUTE</div>
        <h2>Choose what kind of magic your route feeds.</h2>
        <p>Every trail is still a short combat pocket, but clearing it now earns an elemental attunement. That attunement guarantees the next level-up includes a spell choice from that school when one is available.</p>

        @if (CompletedNodes.Count > 0)
        {
            var cleared = CompletedNodes[^1];
            <div class="route-cleared">
                <strong>✓ @cleared.Name cleared</strong>
                <span>@(cleared.AttunementSchool is { } school ? $"{SchoolIcon(school)} {school} attunement earned" : "Choose the next trail.")</span>
            </div>
        }

        <div class="realm-route" aria-label="Wyrmrealm route map">
            @foreach (var stage in Nodes.GroupBy(node => node.Stage).OrderBy(group => group.Key))
            {
                <div class="route-stage">
                    <span class="stage-label">@(stage.Key <= WyrmrealmMapState.CombatStages ? $"TRAIL {stage.Key}" : "DRAGON TRAIL")</span>
                    <div class="route-nodes">
                        @foreach (var node in stage.OrderBy(node => node.Lane))
                        {
                            <button class="@NodeClass(node)" disabled="@(!IsAvailable(node))" @onclick="() => ChooseAsync(node.Id)">
                                <span class="node-icon">@NodeIcon(node)</span>
                                <strong>@node.Name</strong>
                                <small>@NodeDescription(node)</small>
                                @if (node.AttunementSchool is { } school)
                                {
                                    <span class="node-reward">@SchoolIcon(school) ATTUNEMENT • next level-up includes @school</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<WyrmrealmMapNode> Nodes { get; set; } = Array.Empty<WyrmrealmMapNode>();
    [Parameter, EditorRequired] public IReadOnlyList<WyrmrealmMapNode> AvailableNodes { get; set; } = Array.Empty<WyrmrealmMapNode>();
    [Parameter, EditorRequired] public IReadOnlyList<WyrmrealmMapNode> CompletedNodes { get; set; } = Array.Empty<WyrmrealmMapNode>();
    [Parameter] public EventCallback<string> OnChoose { get; set; }

    private bool IsAvailable(WyrmrealmMapNode node) => AvailableNodes.Any(candidate => candidate.Id == node.Id);
    private bool IsCompleted(WyrmrealmMapNode node) => CompletedNodes.Any(candidate => candidate.Id == node.Id);
    private bool IsBypassed(WyrmrealmMapNode node) => CompletedNodes.Any(completed => completed.Stage == node.Stage) && !IsCompleted(node);

    private string NodeClass(WyrmrealmMapNode node)
    {
        var state = IsCompleted(node) ? "completed" : IsAvailable(node) ? "available" : IsBypassed(node) ? "bypassed" : "future";
        var school = node.AttunementSchool is { } attunement ? $" school-{attunement.ToString().ToLowerInvariant()}" : string.Empty;
        return $"route-node {state}{school}";
    }

    private static string NodeIcon(WyrmrealmMapNode node) => node.Type == WyrmrealmNodeType.Dragon ? "🐉" : SchoolIcon(node.AttunementSchool ?? SpellSchool.Arcane);

    private static string NodeDescription(WyrmrealmMapNode node) => node.Type == WyrmrealmNodeType.Dragon
        ? "The trail ends here. Something enormous is waiting."
        : node.EncounterKind switch
        {
            WyrmrealmEncounterKind.Swarm => "5 kills • fast chaser pressure",
            WyrmrealmEncounterKind.StalkerPressure => "5 kills • Rift Stalkers dominate",
            _ => "5 kills • mixed enemy pressure",
        };

    private static string SchoolIcon(SpellSchool school) => school switch
    {
        SpellSchool.Fire => "🔥",
        SpellSchool.Frost => "❄️",
        SpellSchool.Storm => "⚡",
        _ => "✨",
    };

    private Task ChooseAsync(string id) => OnChoose.InvokeAsync(id);
}
