@namespace Wyrmforge.Presentation.Web.Features.Map
@using Wyrmforge.Application.Runs.Navigation
@using Wyrmforge.Application.Runs.Resonance
@using Wyrmforge.Domain.Spells
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="realm-map-overlay">
    <section class="realm-map-card" aria-label="Hunt expedition">
        <header class="map-header">
            <div><div class="eyebrow">THE GREAT HUNT · DEPTH @Depth</div><h2>Choose your trail.</h2></div>
            <b class="map-run-progress">@CompletedNodes.Count(node => node.Type == WyrmrealmNodeType.Combat)/@WyrmrealmMapState.CombatStages</b>
        </header>
        <details class="map-attention">
            <summary>Wyrm signs <b>@DominantLabel</b></summary>
            <div class="resonance-panel" aria-label="Current magic resonance">
                @foreach (var entry in Resonance)
                {
                    <span>@SchoolIcon(entry.School) @entry.School <b>@entry.Value</b></span>
                }
                <DragonSignsView Signs="Signs" Compact="true" />
            </div>
        </details>
        <div class="hunt-viewport" @ref="viewport" tabindex="0" aria-label="Scrollable hunt territory">
            <div class="realm-route" aria-label="Generated Wyrmrealm route map">
                <svg class="hunt-terrain" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    <path class="ridge" d="M0 8L10 3L18 9L27 4L35 10M66 7L76 2L85 8L93 4L100 10M0 27L8 21L17 29L23 23L30 31M75 32L82 24L91 29L100 22M0 63L8 55L17 62L23 56M78 67L85 58L94 64L100 59M0 90L9 83L18 88L25 81M77 87L85 80L94 89L100 85" />
                    <path class="contour" d="M0 13Q18 18 34 12M63 13Q79 17 100 12M0 35Q11 32 24 38M76 37Q85 41 100 34M0 69Q10 65 20 71M79 73Q91 68 100 72M0 96Q12 92 28 97M72 94Q88 92 100 97" />
                    <path class="river" d="M0 72Q15 69 30 73T59 72T81 75T100 73" />
                </svg>
                <span class="territory-label outskirts">OUTSKIRTS</span>
                <span class="territory-label inner-territory">INNER TERRITORY</span>
                <div class="map-entry @(CompletedNodes.Count == 0 ? "current" : string.Empty)" data-current="@(CompletedNodes.Count == 0 ? "true" : "false")" aria-label="Realm entry">
                    <span class="entry-point">◇</span><small>@(CompletedNodes.Count == 0 ? "YOU" : "ENTRY")</small>
                </div>
                <svg class="route-links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    @foreach (var node in Nodes.Where(candidate => candidate.Stage == 1))
                    {
                        <path class="@EntryConnectionClass(node)" d="@EntryConnectionPath(node)" />
                    }
                    @foreach (var node in Nodes.Where(candidate => candidate.Stage > 1))
                    {
                        @foreach (var previousId in node.PreviousNodeIds)
                        {
                            var previous = Nodes.Single(candidate => candidate.Id == previousId);
                            <path class="@ConnectionClass(previous, node)" d="@ConnectionPath(previous, node)" />
                        }
                    }
                </svg>
                @foreach (var node in Nodes.OrderBy(node => node.Stage).ThenBy(node => node.Lane))
                {
                    <button class="@NodeClass(node)" style="@NodeMapStyle(node)" data-stage="@node.Stage" data-current="@(IsCurrent(node) ? "true" : "false")" aria-label="@NodeAriaLabel(node)" aria-pressed="@(selectedNode?.Id == node.Id)" @onclick="() => SelectNode(node)">
                        @if (IsCurrent(node)) { <span class="current-marker">YOU</span> }
                        <span class="node-core">
                            <svg class="node-main-icon" viewBox="0 0 46 34" aria-hidden="true"><path d="@LandmarkPath(node)" /></svg>
                            @if (node.AttunementSchool is { } school) { <span class="node-school">@SchoolIcon(school)</span> }
                            @if (IsCompleted(node) || selectedNode?.Id == node.Id) { <span class="node-check">✓</span> }
                            @if (node.Rarity == WyrmrealmNodeRarity.Rare) { <span class="node-rare" aria-label="Rare trail">✦</span> }
                        </span>
                        <span class="node-name">@(node.Type == WyrmrealmNodeType.Dragon ? "THE LAIR" : node.Name)</span>
                        <span class="node-badges">
                            @foreach (var badge in NodeBadges(node)) { <span class="node-badge @badge.ClassName" title="@badge.Label" aria-label="@badge.Label">@badge.Icon</span> }
                        </span>
                    </button>
                }
            </div>
        </div>
        <aside class="node-sheet" aria-label="Selected trail details">
            @if (selectedNode is { } selected)
            {
                <button class="sheet-close" aria-label="Close trail details" @onclick="ClearSelection">×</button>
                <div class="sheet-heading"><span class="sheet-status @SelectionStatusClass(selected)">@SelectionStatus(selected)</span><h3>@selected.Name</h3></div>
                <div class="sheet-traits">
                    @if (selected.Route is { } route)
                    {
                        <span class="sheet-encounter">@WyrmrealmStageCatalog.Name(selected.Stage)</span>
                        <span class="sheet-guarantee">@SchoolIcon(route.Reward.AttunementSchool) @route.Reward.AttunementSchool upgrade · guaranteed</span>
                        @if (route.Reward.RecoveryFraction > 0) { <span>♥ @($"{route.Reward.RecoveryFraction * 100:0}%") recovery</span> }
                        @if (route.Reward.Relic is not null) { <span>◆ Relic cache</span> }
                        @if (selected.Rarity == WyrmrealmNodeRarity.Rare) { <span class="rare-trait">✦ Rare · stronger enemies</span> }
                        @if (route.ModifierSet.TryGetHazardInterval(WyrmrealmHazardKind.UnstableRifts, out _)) { <span>⚠ Unstable rifts</span> }
                    }
                    else { <span>Wyrm duel · Refuge beyond</span> }
                </div>
                <button class="enter-trail" disabled="@(!IsAvailable(selected))" @onclick="ConfirmSelectedAsync">@(IsAvailable(selected) ? selected.Type == WyrmrealmNodeType.Dragon ? "Face the wyrm" : selected.Rarity == WyrmrealmNodeRarity.Rare ? "Enter rare trail" : "Enter trail" : IsCompleted(selected) ? "Trail cleared" : "Not connected yet")</button>
            }
            else
            {
                <div class="sheet-heading"><h3>Choose a connected trail</h3></div>
                <button class="enter-trail" disabled>Enter trail</button>
            }
        </aside>
    </section>
</div>

@code {
    [Parameter] public int Depth { get; set; } = 1;
    [Parameter, EditorRequired] public IReadOnlyList<WyrmrealmMapNode> Nodes { get; set; } = Array.Empty<WyrmrealmMapNode>();
    [Parameter, EditorRequired] public IReadOnlyList<WyrmrealmMapNode> AvailableNodes { get; set; } = Array.Empty<WyrmrealmMapNode>();
    [Parameter, EditorRequired] public IReadOnlyList<WyrmrealmMapNode> CompletedNodes { get; set; } = Array.Empty<WyrmrealmMapNode>();
    [Parameter, EditorRequired] public IReadOnlyList<RunResonanceEntry> Resonance { get; set; } = Array.Empty<RunResonanceEntry>();
    [Parameter, EditorRequired] public IReadOnlyList<DragonSign> Signs { get; set; } = Array.Empty<DragonSign>();
    [Parameter] public EventCallback<string> OnChoose { get; set; }

    private const double EntryX = 50;
    private const double EntryY = 95;
    private WyrmrealmMapNode? selectedNode;
    private ElementReference viewport;
    private IJSObjectReference? mapModule;
    private string? focusedKey;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var key = $"{Depth}:{CompletedNodes.LastOrDefault()?.Id}";
        if (focusedKey == key) return;
        mapModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/hunt-map.js");
        await mapModule.InvokeVoidAsync("focusHunter", viewport, CompletedNodes.Count > 0);
        focusedKey = key;
    }

    public async ValueTask DisposeAsync()
    {
        if (mapModule is not null) await mapModule.DisposeAsync();
    }
    private int TotalResonance => Resonance.Sum(entry => entry.Value);
    private RunResonanceEntry? DominantResonance => Resonance.OrderByDescending(entry => entry.Value).ThenBy(entry => entry.School).FirstOrDefault();
    private string DominantLabel => DominantResonance is { Value: > 0 } dominant ? $"{SchoolIcon(dominant.School)} {dominant.School}" : "No lead";

    private bool IsAvailable(WyrmrealmMapNode node) => AvailableNodes.Any(candidate => candidate.Id == node.Id);
    private bool IsCompleted(WyrmrealmMapNode node) => CompletedNodes.Any(candidate => candidate.Id == node.Id);
    private bool IsCurrent(WyrmrealmMapNode node) => CompletedNodes.Count > 0 && CompletedNodes[^1].Id == node.Id;
    private bool IsBypassed(WyrmrealmMapNode node) => CompletedNodes.Any(completed => completed.Stage == node.Stage) && !IsCompleted(node);
    private string ResonanceStyle(int value) => $"width: {(TotalResonance == 0 ? 0 : value * 100d / TotalResonance):0.#}%";

    private void SelectNode(WyrmrealmMapNode node) => selectedNode = node;
    private void ClearSelection() => selectedNode = null;
    private Task ConfirmSelectedAsync() => selectedNode is { } node && IsAvailable(node) ? OnChoose.InvokeAsync(node.Id) : Task.CompletedTask;

    private string NodeClass(WyrmrealmMapNode node)
    {
        var state = IsCompleted(node) ? "completed" : IsAvailable(node) ? "available" : IsBypassed(node) ? "bypassed" : "future";
        var rarity = node.Rarity == WyrmrealmNodeRarity.Rare ? " rare" : string.Empty;
        var selected = selectedNode?.Id == node.Id ? " selected" : string.Empty;
        var current = IsCurrent(node) ? " current" : string.Empty;
        var school = node.AttunementSchool?.ToString().ToLowerInvariant() ?? "wyrm";
        var encounter = node.Type == WyrmrealmNodeType.Dragon ? "dragon" : $"stage-{node.Stage}";
        return $"route-node {state}{rarity}{selected}{current} school-{school} {encounter}";
    }

    private string ConnectionClass(WyrmrealmMapNode from, WyrmrealmMapNode to)
    {
        if (IsCompleted(from) && IsCompleted(to)) return "route-link traversed";
        if (IsCurrent(from) && IsAvailable(to)) return selectedNode?.Id == to.Id ? "route-link active selected" : "route-link active";
        return "route-link future";
    }

    private string EntryConnectionClass(WyrmrealmMapNode node)
    {
        if (IsCompleted(node)) return "route-link traversed";
        if (IsAvailable(node)) return selectedNode?.Id == node.Id ? "route-link active selected" : "route-link active";
        return "route-link future";
    }

    private string NodeMapStyle(WyrmrealmMapNode node) => FormattableString.Invariant($"left:{NodeX(node):0.#}%;top:{NodeY(node):0.#}%");
    private string EntryConnectionPath(WyrmrealmMapNode node) => Curve($"entry>{node.Id}", EntryX, EntryY, NodeX(node), NodeY(node));
    private string ConnectionPath(WyrmrealmMapNode from, WyrmrealmMapNode to) => Curve($"{from.Id}>{to.Id}", NodeX(from), NodeY(from), NodeX(to), NodeY(to));

    private double NodeX(WyrmrealmMapNode node)
    {
        if (node.Type == WyrmrealmNodeType.Dragon) return 50;
        var stageNodes = Nodes.Where(candidate => candidate.Stage == node.Stage).OrderBy(candidate => candidate.Lane).ToArray();
        var index = Array.FindIndex(stageNodes, candidate => candidate.Id == node.Id);
        var noise = UnitNoise($"x:{node.Id}");
        return stageNodes.Length <= 1 ? 50 : 14 + index * 72d / (stageNodes.Length - 1) + (noise - 0.5) * 2;
    }

    private static double NodeY(WyrmrealmMapNode node) => node.Type == WyrmrealmNodeType.Dragon ? 5 : 83 - (node.Stage - 1) * 13;

    private static string Curve(string key, double x1, double y1, double x2, double y2)
    {
        var height = y2 - y1;
        var bend = StableNoise(key) * 13;
        var firstControlX = Math.Clamp(x1 + bend, 4, 96);
        var secondControlX = Math.Clamp(x2 - bend * 0.55, 4, 96);
        var firstControlY = y1 + height * 0.34;
        var secondControlY = y1 + height * 0.7;
        return FormattableString.Invariant($"M {x1:0.#} {y1:0.#} C {firstControlX:0.#} {firstControlY:0.#}, {secondControlX:0.#} {secondControlY:0.#}, {x2:0.#} {y2:0.#}");
    }

    private static double UnitNoise(string value) => (StableNoise(value) + 1) / 2;

    private static double StableNoise(string value)
    {
        unchecked
        {
            var hash = 2166136261u;
            foreach (var character in value)
            {
                hash ^= character;
                hash *= 16777619u;
            }
            return (hash % 2001) / 1000d - 1;
        }
    }

    private string SelectionStatus(WyrmrealmMapNode node) => IsAvailable(node) ? "REACHABLE NOW" : IsCompleted(node) ? "CLEARED" : "FUTURE TRAIL";
    private string SelectionStatusClass(WyrmrealmMapNode node) => IsAvailable(node) ? "reachable" : IsCompleted(node) ? "cleared" : "future";

    private static IReadOnlyList<NodeBadge> NodeBadges(WyrmrealmMapNode node)
    {
        if (node.Route is not { } route) return Array.Empty<NodeBadge>();
        var badges = new List<NodeBadge>();
        if (route.Reward.Relic is not null) badges.Add(new("◆", "Relic cache", "reward"));
        if (route.Reward.RecoveryFraction > 0) badges.Add(new("♥", $"Restore {route.Reward.RecoveryFraction * 100:0}% health", "heal"));
        if (route.ModifierSet.TryGetHazardInterval(WyrmrealmHazardKind.UnstableRifts, out _)) badges.Add(new("⚠", "Unstable rifts", "hazard"));
        return badges;
    }

    private static IReadOnlyList<string> DetailTraits(WyrmrealmRouteProfile route)
    {
        var traits = new List<string>();
        if (route.Encounter.SpawnIntervalMultiplier < 0.9) traits.Add("⏱ Fast spawns");
        if (route.Encounter.EnemyHealthMultiplier > 1.1) traits.Add("⬢ Tougher enemies");
        if (route.Encounter.EnemySpeedMultiplier > 1.1) traits.Add("➤ Faster enemies");
        if (route.Reward.Relic is not null) traits.Add("◆ Relic cache");
        if (route.Reward.RecoveryFraction > 0) traits.Add($"♥ Restore {route.Reward.RecoveryFraction * 100:0}% health");
        if (route.ModifierSet.TryGetHazardInterval(WyrmrealmHazardKind.UnstableRifts, out var hazardInterval))
        {
            traits.Add(hazardInterval < 0.8 ? "⚠ Frequent unstable rifts" : "⚠ Unstable rifts");
        }
        if (route.Reward.ScoreBonus > 0) traits.Add($"✦ +{route.Reward.ScoreBonus} base score");
        return traits;
    }

    private static string NodeAriaLabel(WyrmrealmMapNode node) => node.Type == WyrmrealmNodeType.Dragon
        ? "Unknown wyrm encounter"
        : $"Trail {node.Stage}, {node.Name}, {node.AttunementSchool}, {EncounterLabel(node.EncounterKind ?? WyrmrealmEncounterKind.Mixed)}";

    private static string LandmarkPath(WyrmrealmMapNode node) => node.Type == WyrmrealmNodeType.Dragon
        ? "M5 27L5 17L11 6L16 13L23 3L29 14L35 7L41 18L41 27M15 27V20Q23 9 31 20V27M20 20L23 17L26 20"
        : node.Stage switch
        {
            1 or 3 => "M5 28V14H39V28M11 28V24Q17 12 23 24V28M23 28V24Q29 12 35 24V28M9 9V14M35 9V14",
            2 => "M5 20L14 7L23 20L32 8L40 23M10 28L18 18L26 28L34 18L40 28",
            4 or 5 => "M8 28V10H15V28M20 28V6H27V28M33 28V13H39V28M5 29H42",
            _ => "M9 29V11L15 6L22 11L29 6L35 11V29M16 29V20Q22 12 28 20V29",
        };

    private static string NodeIcon(WyrmrealmMapNode node) => node.Type == WyrmrealmNodeType.Dragon ? "◇" : "◈";

    private static string EncounterLabel(WyrmrealmEncounterKind kind) => kind switch
    {
        WyrmrealmEncounterKind.Swarm => "Swarm",
        WyrmrealmEncounterKind.StalkerPressure => "Stalker pressure",
        _ => "Mixed pressure",
    };

    private static string SchoolIcon(SpellSchool school) => school switch
    {
        SpellSchool.Fire => "✹",
        SpellSchool.Frost => "❄",
        SpellSchool.Storm => "ϟ",
        _ => "✦",
    };

    private sealed record NodeBadge(string Icon, string Label, string ClassName);
}
