@namespace Wyrmforge.Presentation.Web.Features.Map
@using Wyrmforge.Application.Runs.Navigation
@using Wyrmforge.Application.Runs.Resonance

<div class="realm-map-overlay"><section class="realm-map-card"><div class="eyebrow">WYRMREALM • DEPTH @Depth</div><h2>Choose the next trail.</h2><p>Routes carry different pressure, hazards and rewards. Some hide relic caches that can reshape the rest of your run.</p><DragonSignsView Signs="Signs" /><div class="realm-route">
@foreach (var stage in Nodes.GroupBy(node => node.Stage).OrderBy(group => group.Key)) { <div class="route-stage"><span class="stage-label">@(stage.Key <= WyrmrealmMapState.CombatStages ? $"TRAIL {stage.Key}" : "DRAGON TRAIL")</span><div class="route-nodes">@foreach (var node in stage.OrderBy(node => node.Lane)) { <button class="@NodeClass(node)" disabled="@(!IsAvailable(node))" @onclick="() => ChooseAsync(node.Id)"><span class="node-icon">@(node.Type == WyrmrealmNodeType.Dragon ? "🐉" : "✦")</span><strong>@node.Name</strong><small>@(node.Type == WyrmrealmNodeType.Dragon ? "Something enormous waits beyond the trail." : $"{WyrmrealmMapState.KillsPerCombatNode} kills • {node.Route?.Encounter.Kind}")</small>@if (node.Route is { } route) { <span class="node-reward">@RewardDescription(route.Reward)</span>@if (route.Hazard is not null) { <span class="node-hazard">⚠ unstable rifts</span> } }</button> }</div></div> }
</div></section></div>

@code {
    [Parameter] public int Depth { get; set; } = 1;
    [Parameter, EditorRequired] public IReadOnlyList<WyrmrealmMapNode> Nodes { get; set; } = Array.Empty<WyrmrealmMapNode>();
    [Parameter, EditorRequired] public IReadOnlyList<WyrmrealmMapNode> AvailableNodes { get; set; } = Array.Empty<WyrmrealmMapNode>();
    [Parameter, EditorRequired] public IReadOnlyList<WyrmrealmMapNode> CompletedNodes { get; set; } = Array.Empty<WyrmrealmMapNode>();
    [Parameter, EditorRequired] public IReadOnlyList<RunResonanceEntry> Resonance { get; set; } = Array.Empty<RunResonanceEntry>();
    [Parameter, EditorRequired] public IReadOnlyList<DragonSign> Signs { get; set; } = Array.Empty<DragonSign>();
    [Parameter] public EventCallback<string> OnChoose { get; set; }
    private bool IsAvailable(WyrmrealmMapNode node) => AvailableNodes.Any(candidate => candidate.Id == node.Id);
    private bool IsCompleted(WyrmrealmMapNode node) => CompletedNodes.Any(candidate => candidate.Id == node.Id);
    private bool IsBypassed(WyrmrealmMapNode node) => CompletedNodes.Any(completed => completed.Stage == node.Stage) && !IsCompleted(node);
    private string NodeClass(WyrmrealmMapNode node) => IsCompleted(node) ? "route-node completed" : IsAvailable(node) ? "route-node available" : IsBypassed(node) ? "route-node bypassed" : "route-node future";
    private static string RewardDescription(WyrmrealmRewardProfile reward) => $"{reward.AttunementSchool} resonance{(reward.ScoreBonus > 0 ? $" • +{reward.ScoreBonus} score" : string.Empty)}{(reward.RecoveryFraction > 0 ? $" • heal {reward.RecoveryFraction * 100:0}%" : string.Empty)}{(reward.Relic is not null ? " • ✧ RELIC CACHE" : string.Empty)}";
    private Task ChooseAsync(string id) => OnChoose.InvokeAsync(id);
}
