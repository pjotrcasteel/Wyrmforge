@using Wyrmforge.Application.Chronicles
@using Wyrmforge.Application.World
@using Wyrmforge.Domain.Chronicles
@using Wyrmforge.Domain.Combat.Dragons
@using Wyrmforge.Domain.World

@* One decision per mobile screen. The original painted gateway is preserved; no companion or invented Wyrm artwork is added. *@
<section class="world-gate" aria-label="World Gate">
    @if (page is GatePage.Gateway or GatePage.Modes)
    {
        <div class="gate-scene">
            <img class="gate-scene-art" src="art/world-gate.jpg" alt="" aria-hidden="true" draggable="false" />
            <div class="gate-closed-side" aria-hidden="true"></div>
            @if (page == GatePage.Gateway)
            {
                <button type="button" class="gate-arch-choice gate-arch-choice--free" @onclick="() => page = GatePage.Modes"
                        aria-label="Enter Free Play">
                    <span class="gate-arch-title">FREE PLAY</span>
                </button>
                <div class="gate-arch-choice gate-arch-choice--campaign" aria-label="Campaign, coming later">
                    <span class="gate-arch-title">CAMPAIGN</span>
                    <small>COMING LATER</small>
                </div>
            }
            else
            {
                <div class="gate-scene-dim" aria-hidden="true"></div>
            }
        </div>
        @if (page == GatePage.Gateway)
        {
            <p class="gate-instruction">Choose your path</p>
        }
        else
        {
            <section class="gate-mode-sheet" aria-label="Free Play">
                <div class="gate-sheet-handle" aria-hidden="true"></div>
                <h2>FREE PLAY</h2>
                <button type="button" class="gate-action gate-action--primary" @onclick="() => page = GatePage.Elements">
                    <span class="gate-action-icon" aria-hidden="true">⚔</span>
                    <span>New Hunt</span>
                    <span aria-hidden="true">›</span>
                </button>
                <button type="button" class="gate-action gate-action--locked" disabled aria-label="Endless Hunt, coming later">
                    <span class="gate-action-icon" aria-hidden="true">∞</span>
                    <span>Endless Hunt</span>
                    <span class="gate-lock" aria-hidden="true">◆</span>
                </button>
                <button type="button" class="gate-action gate-action--locked" disabled aria-label="Endless Arena, coming later">
                    <span class="gate-action-icon" aria-hidden="true">♜</span>
                    <span>Endless Arena</span>
                    <span class="gate-lock" aria-hidden="true">◆</span>
                </button>
                <button type="button" class="gate-text-back" @onclick="Back">‹ Back to World Gate</button>
            </section>
        }
    }
    else if (page == GatePage.Elements)
    {
        <div class="gate-selection">
            <header class="gate-selection-header">
                <button type="button" class="gate-nav-back" aria-label="Back to Free Play" @onclick="Back">‹</button>
                <div>
                    <span class="gate-eyebrow">NEW HUNT</span>
                    <h2>Choose a Wyrm lineage</h2>
                </div>
            </header>
            <div class="gate-lineage-grid" aria-label="Wyrm lineages">
                @foreach (var lineage in Lineages)
                {
                    var available = IsAvailable(lineage);
                    <button @key="lineage.Key" type="button"
                            class="gate-lineage gate-lineage--@lineage.Key @(available ? "gate-lineage--available" : "gate-lineage--hidden")"
                            disabled="@(!available)"
                            aria-label="@(available ? $"{lineage.Name}, choose Wyrm tier" : $"{lineage.Name} Wyrm lineage, not yet available")"
                            @onclick="() => ChooseLineage(lineage)">
                        <span class="gate-sigil gate-sigil--@lineage.Key" aria-hidden="true"></span>
                        <span class="gate-lineage-name">@lineage.Name</span>
                        @if (!available)
                        {
                            <span class="gate-lineage-lock" aria-hidden="true">◆</span>
                        }
                    </button>
                }
            </div>
            <p class="gate-discovery-hint">Other Wyrm lineages await their Hunts.</p>
        </div>
    }
    else if (selectedLineage is { } selected)
    {
        <div class="gate-selection gate-selection--tiers">
            <header class="gate-selection-header">
                <button type="button" class="gate-nav-back" aria-label="Back to Wyrm lineages" @onclick="Back">‹</button>
                <div>
                    <span class="gate-eyebrow">NEW HUNT</span>
                    <h2><span class="gate-sigil gate-sigil--@selected.Key gate-heading-sigil" aria-hidden="true"></span> @selected.Name</h2>
                    <p>Choose your Wyrm tier</p>
                </div>
            </header>
            <div class="gate-tier-list" aria-label="@selected.Name Wyrm tiers">
                @foreach (var tier in selected.Tiers)
                {
                    <button @key="tier.Number" type="button" class="gate-tier @(tier.Playable ? $"gate-tier--ready gate-tier--{selected.Key}" : "gate-tier--locked")"
                            disabled="@(!tier.Playable || starting)" @onclick="() => BeginHuntAsync(tier)">
                        <span class="gate-tier-number">Tier @tier.Number</span>
                        <span class="gate-tier-label">@(tier.Playable ? "Begin Hunt" : "Not yet available")</span>
                        <span class="gate-tier-chevron" aria-hidden="true">@(tier.Playable ? "›" : "◆")</span>
                    </button>
                }
            </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public RegionDefinition Region { get; set; } = RegionCatalog.Starting;
    [Parameter] public RegionDiscoveryState? World { get; set; }
    [Parameter] public AdvancementProgress Advancement { get; set; } = new(AdvancementRoute.None, 1, 0, 0);
    [Parameter] public StoryBookDefinition Book { get; set; } = StoryBookCatalog.BrokenCovenant;
    [Parameter] public RegionAccessContext? Access { get; set; }
    [Parameter] public EventCallback<RegionId> OnRegionChanged { get; set; }
    [Parameter] public EventCallback OnExplore { get; set; }

    private GatePage page = GatePage.Gateway;
    private LineageChoice? selectedLineage;
    private bool starting;

    // Tier choices are derived from the actual Wyrm hierarchy; only ordinary Wyrm Hunts
    // have an implemented selection path. Higher tiers need their own encounter contracts.
    private static readonly IReadOnlyList<TierChoice> InitialTiers = Enum.GetValues<WyrmTier>()
        .Select(tier => new TierChoice((int)tier + 1, tier == WyrmTier.Wyrm))
        .ToArray();

    // Region/Wyrm choice is independent of a character's Divine magical affinity.
    // Every reserved lineage uses its owner's approved canonical pixel-art sigil.
    // Only Fire and Frost can currently enter Tier-I Hunts.
    private static readonly IReadOnlyList<LineageChoice> Lineages =
    [
        new("fire", "Fire", RegionCatalog.CinderFrontierId, InitialTiers),
        new("frost", "Frost", RegionCatalog.FrostRegionId, InitialTiers),
        new("storm", "Storm", null, []),
        new("arcane", "Arcane", null, []),
        new("necromancy", "Necromancy", null, []),
        new("summoner", "Summoner", null, []),
    ];

    private bool IsAvailable(LineageChoice lineage) =>
        lineage.Region is { } id && RegionCatalog.Find(id) is { } region && (Access is null || region.IsOpen(Access));

    private void ChooseLineage(LineageChoice lineage)
    {
        if (!IsAvailable(lineage)) return;
        selectedLineage = lineage;
        page = GatePage.Tiers;
    }

    private async Task BeginHuntAsync(TierChoice tier)
    {
        if (starting || !tier.Playable || selectedLineage?.Region is not { } region || !IsAvailable(selectedLineage)) return;
        starting = true;
        try
        {
            await OnRegionChanged.InvokeAsync(region);
            await OnExplore.InvokeAsync();
        }
        finally
        {
            starting = false;
        }
    }

    private void Back() => page = page switch
    {
        GatePage.Modes => GatePage.Gateway,
        GatePage.Elements => GatePage.Modes,
        GatePage.Tiers => GatePage.Elements,
        _ => GatePage.Gateway,
    };

    private enum GatePage { Gateway, Modes, Elements, Tiers }
    private sealed record TierChoice(int Number, bool Playable);
    private sealed record LineageChoice(string Key, string Name, RegionId? Region, IReadOnlyList<TierChoice> Tiers);
}
