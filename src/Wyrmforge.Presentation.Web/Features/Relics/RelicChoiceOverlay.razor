@namespace Wyrmforge.Presentation.Web.Features.Relics
@using Wyrmforge.Domain.Progression.Relics

<div class="relic-overlay">
    <section class="relic-card">
        <div class="eyebrow">RELIC CACHE • CHOOSE ONE</div>
        <h2>Something old survived the realm.</h2>
        <p>Relics are permanent for this run. The first two you find equip automatically; any others remain in your pack until you reach the Refuge.</p>
        <div class="relic-choices">
            @foreach (var relic in Choices)
            {
                <button class="relic-choice rarity-@relic.Rarity.ToString().ToLowerInvariant()" @onclick="() => ChooseAsync(relic.Id)">
                    <span class="relic-rarity">@relic.Rarity.ToString().ToUpperInvariant()</span>
                    <span class="relic-icon">@relic.Icon</span>
                    <strong>@relic.Name</strong>
                    <span>@relic.Description</span>
                    <small>Take this relic for the rest of the run.</small>
                </button>
            }
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RelicDefinition> Choices { get; set; } = Array.Empty<RelicDefinition>();
    [Parameter] public EventCallback<RelicId> OnChoose { get; set; }

    private Task ChooseAsync(RelicId id) => OnChoose.InvokeAsync(id);
}
