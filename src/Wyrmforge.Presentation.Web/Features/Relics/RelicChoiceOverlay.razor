@namespace Wyrmforge.Presentation.Web.Features.Relics
@using Wyrmforge.Domain.Progression.Relics
@using Wyrmforge.Application.Runs.Relics

<div class="relic-overlay run-overlay">
    <section class="relic-card run-overlay-surface">
        <div class="eyebrow">RELIC CACHE • CHOOSE ONE</div>
        <h2>Choose a relic</h2>
        <p>@(Equipped.Count < RelicInventoryState.MaxEquipped ? "Equips immediately · this hunt only" : "Two slots full · choose a replacement")</p>
        @if (selected is { } replacementChoice)
        {
            <div class="relic-replacement" aria-label="Choose relic to replace">
                <strong>@RelicCatalog.Get(replacementChoice).Name</strong>
                @foreach (var old in Equipped)
                {
                    <button @onclick="() => OnChoose.InvokeAsync(new RelicSelection(replacementChoice, old.Id))">Replace @old.Name<small>@old.Description</small></button>
                }
                <button @onclick="() => selected = null">Back to relic choices</button>
            </div>
        }
        else
        {
        <div class="relic-choices">
            @foreach (var relic in Choices)
            {
                <button class="relic-choice rarity-@relic.Rarity.ToString().ToLowerInvariant()" @onclick="() => ChooseAsync(relic.Id)">
                    <span class="relic-rarity">@relic.Rarity.ToString().ToUpperInvariant()</span>
                    <span class="relic-icon">@relic.Icon</span>
                    <strong>@relic.Name</strong>
                    <span>@relic.Description</span>
                    <small>@RelicChoiceService.Role(relic.Id) · @(Equipped.Count < RelicInventoryState.MaxEquipped ? "Equip" : "Replace a relic")</small>
                </button>
            }
        </div>
        }
    </section>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RelicDefinition> Choices { get; set; } = Array.Empty<RelicDefinition>();
    [Parameter] public IReadOnlyList<RelicDefinition> Equipped { get; set; } = [];
    [Parameter] public EventCallback<RelicSelection> OnChoose { get; set; }
    private RelicId? selected;

    private Task ChooseAsync(RelicId id)
    {
        if (Equipped.Count < RelicInventoryState.MaxEquipped) return OnChoose.InvokeAsync(new RelicSelection(id));
        selected = id;
        return Task.CompletedTask;
    }
}
