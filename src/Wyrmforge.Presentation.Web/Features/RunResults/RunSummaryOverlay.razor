@namespace Wyrmforge.Presentation.Web.Features.RunResults

<div class="game-over">
    <div class="game-over-card">
        <div class="eyebrow">@OutcomeLabel</div>
        <h2>@Summary.Score.ToString("N0") score</h2>
        <p>@OutcomeMessage</p>
        <p>Depth @Summary.Depth • Level @Summary.Level • @Summary.Spells spells • @Summary.Synergies synergies • @Summary.DragonEssences essences • @Summary.DragonsSlain dragons • @Summary.Choices choices • @Summary.Kills kills • @Summary.Seconds s survived</p>
        <button class="primary" @onclick="ReturnAsync">Return to Wyrmforge</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Wyrmforge.Application.Runs.EndRun.RunSummary Summary { get; set; } = null!;

    [Parameter]
    public EventCallback OnReturn { get; set; }

    private string OutcomeLabel => Summary.Outcome switch
    {
        RunOutcome.Extracted => "EXTRACTION SUCCESSFUL",
        RunOutcome.Defeated => "RUN LOST",
        RunOutcome.Abandoned => "RUN ABANDONED",
        _ => "RUN ENDED",
    };

    private string OutcomeMessage => Summary.Outcome switch
    {
        RunOutcome.Extracted when Summary.DragonEssences > 0 => "You escaped the Wyrmrealm with the stolen essence secured.",
        RunOutcome.Extracted => "You escaped the Wyrmrealm safely.",
        RunOutcome.Defeated when Summary.DragonEssences > 0 => "The Wyrmrealm kept the essence you stole.",
        RunOutcome.Abandoned when Summary.DragonEssences > 0 => "You left without completing an extraction. The stolen essence was not secured.",
        RunOutcome.Defeated => "The Wyrmrealm ended this run.",
        _ => "The run ended before extraction.",
    };

    private Task ReturnAsync() => OnReturn.InvokeAsync();
}
