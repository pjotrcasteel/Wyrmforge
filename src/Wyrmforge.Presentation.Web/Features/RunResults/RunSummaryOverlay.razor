@using Wyrmforge.Domain.Combat.Dragons
@using Wyrmforge.Domain.Progression.DragonEssences
@using Wyrmforge.Domain.Progression.Forge
@using Wyrmforge.Domain.Progression.SpellMastery
@using Wyrmforge.Domain.Progression.GreatHunt
@using Wyrmforge.Presentation.Web.Features.Forge
@using Wyrmforge.Domain.Progression.Relics
@using Wyrmforge.Domain.Progression.RunUpgrades
@using Wyrmforge.Domain.Spells
@using Wyrmforge.Domain.Spells.Evolutions
@using Wyrmforge.Domain.Spells.Synergies
@namespace Wyrmforge.Presentation.Web.Features.RunResults

<div class="game-over run-overlay">
    <div class="game-over-card run-report-card run-overlay-surface">
        <header class="run-report-hero">
            <span class="eyebrow">@OutcomeLabel</span>
            <h2>@Summary.Score.ToString("N0") <small>score</small></h2>
            <p>@OutcomeMessage</p>
        </header>

        <div class="run-report-grid">
            <section>
                <span>YOUR BUILD</span>
                <strong>@BuildIdentity</strong>
                <small>@ResonanceSummary</small>
            </section>
            <section>
                <span>JOURNEY</span>
                <strong>Depth @Summary.Depth • Level @Summary.Level</strong>
                <small>@Summary.CompletedRouteNodes trails • @Summary.Kills kills • @Summary.Seconds s</small>
            </section>
        </div>

        @if (AdvancedSpells.Count > 0)
        {
            <section class="run-mastery-progress" aria-label="Spell mastery earned">
                <span>✦ SPELL MASTERY ADVANCED</span>
                <div class="run-mastery-entries">
                    @foreach (var id in AdvancedSpells)
                    {
                        var definition = SpellLineageCatalog.Get(id);
                        var state = Masteries.Get(id);
                        var spell = SpellCatalog.Get(id);
                        <div class="run-mastery-entry">
                            <strong>@spell.Icon @spell.Name</strong>
                            <small>@Math.Min(state.MeaningfulRuns, definition.RequiredRuns) / @definition.RequiredRuns hunts • @(state.WyrmFeat ? "Wyrm feat ✓" : "Wyrm feat pending")</small>
                        </div>
                    }
                </div>
            </section>
        }

        @if (NewAscendantVictories.Count > 0)
        {
            <section class="run-ascendant-victory" aria-label="Ascendant Wyrm conquered">
                <span>✦ ASCENDANT CONQUERED ✦</span>
                <div aria-hidden="true">♛</div>
                <h3>The Crown of Embers</h3>
                <p>You endured Crownfall and brought down Ascendant Ashfang. Your permanent Crown now shines in the Great Hunt altar.</p>
                <strong>NEW TROPHY • ASCENDANT ASHFANG REMAINS REPLAYABLE</strong>
            </section>
        }

        @if (NewSeals.Count > 0)
        {
            <section class="run-great-hunt-seal" aria-label="Great Hunt oath sealed">
                <span>✦ THE GREAT HUNT REMEMBERS ✦</span>
                @foreach (var wyrm in NewSeals)
                {
                    var oath = GreatHuntCatalog.Get(wyrm);
                    <div class="run-great-hunt-rune" aria-hidden="true">@oath.Rune</div>
                    <h3>@oath.Name</h3>
                    <p>All four deeds completed. Your permanent Great Hunt seal now burns in the Forge and Codex.</p>
                }
                <strong>ASCENDANT PATH PREPARED • NEW ENCOUNTER IN A FUTURE CHAPTER</strong>
            </section>
        }
        @if (AdvancedOaths.Count > 0)
        {
            <section class="run-great-hunt-progress" aria-label="Great Hunt progress">
                <span>◆ GREAT HUNT OATHS ADVANCED</span>
                <div class="run-great-hunt-entries">
                    @foreach (var wyrm in AdvancedOaths)
                    {
                        var oath = GreatHuntCatalog.Get(wyrm);
                        var entry = Hunt.Get(wyrm);
                        <div><strong>@oath.Rune @oath.Name</strong><small>@(entry.Feats + (Masteries.Get(oath.LineageSpell).Unlocked ? 1 : 0)) / 4 deeds complete</small></div>
                    }
                </div>
            </section>
        }

        @if (NewLineages.Count > 0)
        {
            <section class="run-lineage-reveal" aria-label="Wyrmforged lineage discovered">
                <span>✦ AN ANCIENT LINEAGE HAS AWAKENED ✦</span>
                @foreach (var evolutionId in NewLineages)
                {
                    var evolution = SpellEvolutionCatalog.Get(evolutionId);
                    <h3>@evolution.Icon @evolution.Name</h3>
                    <p>@evolution.Description</p>
                }
                <strong>NEW EVOLUTION AVAILABLE IN FUTURE HUNTS</strong>
            </section>
        }

        <div class="run-report-actions">
            <button class="secondary" @onclick="ReplayAsync">↻ Replay seed</button>
            <button class="primary" @onclick="ReturnAsync">Return to Wyrmforge</button>
        </div>

        <button class="run-playtest-feedback" @onclick="() => OnFeedback.InvokeAsync()">✎ Send playtest feedback about this run</button>

        <details class="run-report-details">
            <summary><span>BUILD, LOOT &amp; RUN DETAILS</span><span aria-hidden="true">⌄</span></summary>
            <div class="run-report-expanded">
                <section class="run-story">
                    <span>RUN STORY</span>
                    <strong>@RunStory</strong>
                    <small>@RunStoryDetail</small>
                </section>
        <div class="run-report-section">
            <span>SPELLS</span>
            <div class="run-report-chips">
                @foreach (var spell in Summary.SpellLoadout)
                {
                    var definition = SpellCatalog.Get(spell.Id);
                    var evolution = spell.Evolution is { } evolutionId ? SpellEvolutionCatalog.Get(evolutionId) : null;
                    <b>@(evolution?.Icon ?? definition.Icon) @(evolution?.Name ?? definition.Name) @Roman(spell.Rank)@(evolution is null ? string.Empty : $" • {definition.Name}")</b>
                }
            </div>
        </div>

        @if (Summary.UpgradeLoadout.Count > 0)
        {
            <div class="run-report-section">
                <span>RUN UPGRADES</span>
                <div class="run-report-chips">
                    @foreach (var upgrade in Summary.UpgradeLoadout)
                    {
                        var definition = RunUpgradeCatalog.Get(upgrade.Id);
                        <b>@definition.Icon @definition.Name @Roman(upgrade.Rank)</b>
                    }
                </div>
            </div>
        }

        @if (Summary.SynergyIds.Count > 0)
        {
            <div class="run-report-section">
                <span>SYNERGIES</span>
                <div class="run-report-chips">
                    @foreach (var id in Summary.SynergyIds)
                    {
                        var synergy = SynergyCatalog.Get(id);
                        <b>@synergy.Icon @synergy.Name</b>
                    }
                </div>
            </div>
        }

        @if (Summary.RelicLoadout.Count > 0)
        {
            <div class="run-report-section">
                <span>RELICS</span>
                <div class="run-report-chips">
                    @foreach (var relic in Summary.RelicLoadout)
                    {
                        var definition = RelicCatalog.Get(relic.Id);
                        <b>@definition.Icon @definition.Name@(relic.Equipped ? " • equipped" : string.Empty)</b>
                    }
                </div>
            </div>
        }

        @if (Summary.DragonIds.Count > 0 || Summary.EssenceIds.Count > 0)
        {
            <div class="run-report-section">
                <span>WYRM HUNT</span>
                <p>@WyrmSummary</p>
                @if (Summary.EssenceIds.Count > 0)
                {
                    <div class="run-report-chips">
                        @foreach (var essenceId in Summary.EssenceIds)
                        {
                            var essence = DragonEssenceCatalog.Get(essenceId);
                            <b>@essence.Icon @essence.Name</b>
                        }
                    </div>
                }
            </div>
        }


                <p class="run-report-meta">@Summary.Choices build choices • @Summary.RareRouteNodes rare trails • @Summary.DragonEssences secured Essence • seed @Summary.Seed</p>
            </div>
        </details>
        <details class="run-report-next">
            <summary><span>YOUR NEXT THREE PURSUITS</span><span aria-hidden="true">⌄</span></summary>
            <ForgeGoalBoard Progression="Progression" Vault="Vault" Masteries="Masteries" Hunt="Hunt" Compact="true" />
        </details>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Wyrmforge.Application.Runs.EndRun.RunSummary Summary { get; set; } = null!;
    [Parameter, EditorRequired] public ForgeProgressionState Progression { get; set; } = null!;
    [Parameter, EditorRequired] public DragonEssenceVault Vault { get; set; } = null!;
    [Parameter] public SpellMasteryState Masteries { get; set; } = new();
    [Parameter] public GreatHuntState Hunt { get; set; } = new();
    [Parameter] public IReadOnlyList<DragonId> AdvancedOaths { get; set; } = [];
    [Parameter] public IReadOnlyList<DragonId> NewSeals { get; set; } = [];
    [Parameter] public IReadOnlyList<DragonId> NewAscendantVictories { get; set; } = [];
    [Parameter] public IReadOnlyList<SpellEvolutionId> NewLineages { get; set; } = [];
    [Parameter] public IReadOnlyList<SpellId> AdvancedSpells { get; set; } = [];
    [Parameter] public EventCallback OnReplay { get; set; }
    [Parameter] public EventCallback OnReturn { get; set; }
    [Parameter] public EventCallback OnFeedback { get; set; }

    private string BuildIdentity
    {
        get
        {
            if (Summary.Resonance.Count == 0) return "Unshaped mage";
            var first = Summary.Resonance[0];
            if (Summary.Resonance.Count > 1 && Summary.Resonance[1].Value >= first.Value * 0.75)
            {
                return $"{first.School} / {Summary.Resonance[1].School} hybrid";
            }
            return $"{first.School} attuned";
        }
    }

    private string RunStory
    {
        get
        {
            var wyrms = Summary.DragonIds.Count;
            var wyrmText = wyrms switch { 0 => "no Wyrms slain", 1 => "1 Wyrm slain", _ => $"{wyrms} Wyrms slain" };
            return $"{BuildIdentity} • Depth {Summary.Depth} • {wyrmText}";
        }
    }

    private string RunStoryDetail
    {
        get
        {
            var parts = new List<string>();
            var evolutions = Summary.SpellLoadout.Count(spell => spell.Evolution is not null);
            if (evolutions > 0) parts.Add($"{evolutions} spell evolution{(evolutions == 1 ? string.Empty : "s")} forged");
            if (Summary.SynergyIds.Count > 0) parts.Add($"{Summary.SynergyIds.Count} Synerg{(Summary.SynergyIds.Count == 1 ? "y" : "ies")} awakened");
            if (Summary.RareRouteNodes > 0) parts.Add($"{Summary.RareRouteNodes} rare trail{(Summary.RareRouteNodes == 1 ? string.Empty : "s")} cleared");
            if (Summary.DragonEssences > 0) parts.Add($"{Summary.DragonEssences} Essence secured");
            return parts.Count == 0 ? "The build never found a defining breakthrough this time." : string.Join(" • ", parts);
        }
    }

    private string ResonanceSummary => Summary.Resonance.Count == 0
        ? "No meaningful resonance formed."
        : string.Join(" • ", Summary.Resonance.Select(entry => $"{entry.School} {entry.Value}"));

    private string WyrmSummary => Summary.DragonIds.Count == 0
        ? "No Wyrm was slain."
        : $"Slain: {string.Join(" • ", Summary.DragonIds.Select(id => DragonCatalog.Get(id).Name))}";

    private string OutcomeLabel => Summary.Outcome switch
    {
        RunOutcome.Extracted => "EXTRACTION SUCCESSFUL",
        RunOutcome.Defeated => "RUN LOST",
        RunOutcome.Abandoned => "RUN ABANDONED",
        _ => "RUN ENDED",
    };

    private string OutcomeMessage => Summary.Outcome switch
    {
        RunOutcome.Extracted when Summary.DragonEssences == 1 => "You returned to the Forge with one Wyrm Essence secured.",
        RunOutcome.Extracted when Summary.DragonEssences > 1 => $"You returned to the Forge with {Summary.DragonEssences} Wyrm Essences secured.",
        RunOutcome.Extracted => "You returned to the Forge safely.",
        RunOutcome.Defeated when Summary.DragonEssences == 1 => "You fell deeper in the realm, but one Essence had already been secured at Refuge.",
        RunOutcome.Defeated when Summary.DragonEssences > 1 => $"You fell deeper in the realm, but {Summary.DragonEssences} Essences had already been secured at Refuge.",
        RunOutcome.Abandoned when Summary.DragonEssences == 1 => "The current haul was lost, but one earlier Essence was already secured.",
        RunOutcome.Abandoned when Summary.DragonEssences > 1 => $"The current haul was lost, but {Summary.DragonEssences} earlier Essences were already secured.",
        RunOutcome.Defeated => "The Wyrmrealm ended this run before any Essence reached Refuge.",
        RunOutcome.Abandoned => "You left before the current Essence could be secured.",
        _ => "The run ended before extraction.",
    };

    private static string Roman(int value) => value switch { 1 => "I", 2 => "II", 3 => "III", 4 => "IV", 5 => "V", _ => value.ToString() };
    private Task ReplayAsync() => OnReplay.InvokeAsync();
    private Task ReturnAsync() => OnReturn.InvokeAsync();
}
