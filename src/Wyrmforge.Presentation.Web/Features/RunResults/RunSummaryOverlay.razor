@using Wyrmforge.Domain.Combat.Dragons
@namespace Wyrmforge.Presentation.Web.Features.RunResults

<div class="game-over">
    <div class="game-over-card">
        <div class="eyebrow">@OutcomeLabel</div>
        <h2>@Summary.Score.ToString("N0") score</h2>
        <p>@OutcomeMessage</p>
        <p>Hunt route • @FirstDragon.Name → @DeepDragon.Name</p>
        <p>Depth @Summary.Depth • Level @Summary.Level • @Summary.Spells spells • @Summary.Synergies synergies • @Summary.DragonEssences secured essences • @Summary.DragonsSlain dragons • @Summary.Choices choices • @Summary.Kills kills • @Summary.Seconds s survived</p>
        <button class="primary" @onclick="ReturnAsync">Return to Wyrmforge</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Wyrmforge.Application.Runs.EndRun.RunSummary Summary { get; set; } = null!;

    [Parameter]
    public DragonId HuntTarget { get; set; } = DragonId.Ashfang;

    [Parameter]
    public EventCallback OnReturn { get; set; }

    private DragonDefinition FirstDragon => DragonCatalog.Get(HuntTarget);

    private DragonDefinition DeepDragon => DragonCatalog.Get(HuntTarget == DragonId.Ashfang ? DragonId.Stormcoil : DragonId.Ashfang);

    private string OutcomeLabel => Summary.Outcome switch
    {
        RunOutcome.Extracted => "EXTRACTION SUCCESSFUL",
        RunOutcome.Defeated => "RUN LOST",
        RunOutcome.Abandoned => "RUN ABANDONED",
        _ => "RUN ENDED",
    };

    private string OutcomeMessage => Summary.Outcome switch
    {
        RunOutcome.Extracted when Summary.DragonEssences == 1 => "You returned to the Forge with one Wyrm Essence secured.",
        RunOutcome.Extracted when Summary.DragonEssences > 1 => $"You returned to the Forge with {Summary.DragonEssences} Wyrm Essences secured.",
        RunOutcome.Extracted => "You returned to the Forge safely.",
        RunOutcome.Defeated when Summary.DragonEssences == 1 => "You fell deeper in the realm, but one Essence had already been secured at Refuge.",
        RunOutcome.Defeated when Summary.DragonEssences > 1 => $"You fell deeper in the realm, but {Summary.DragonEssences} Essences had already been secured at Refuge.",
        RunOutcome.Abandoned when Summary.DragonEssences == 1 => "The current haul was lost, but one earlier Essence was already secured.",
        RunOutcome.Abandoned when Summary.DragonEssences > 1 => $"The current haul was lost, but {Summary.DragonEssences} earlier Essences were already secured.",
        RunOutcome.Defeated => "The Wyrmrealm ended this run before any Essence reached Refuge.",
        RunOutcome.Abandoned => "You left before the current Essence could be secured.",
        _ => "The run ended before extraction.",
    };

    private Task ReturnAsync() => OnReturn.InvokeAsync();
}
