@implements IAsyncDisposable
@namespace Wyrmforge.Presentation.Web.Features.Leaderboard
@using Microsoft.JSInterop
@inject IJSRuntime JavaScript

<div class="hall-backdrop">
    <section class="hall-card" role="dialog" aria-modal="true" aria-label="Hall of Fame high scores">
        <header>
            <span>CHAPTER II · THE HALL AWAKENS</span>
            <button @onclick="CloseAsync" aria-label="Close Hall of Fame">✕</button>
        </header>
        <h2>HALL OF FAME</h2>
        <p><strong>LEGEND · DEMO</strong> entries are fictional. Player scores are <strong>COMMUNITY · UNVERIFIED</strong>.</p>
        <div class="hall-scores" aria-label="High-score rankings">
            @foreach (var (entry, index) in SortedEntries.Select((entry, index) => (entry, index)))
            {
                <article class="@(entry.Type == "yours" ? "hall-yours" : string.Empty)">
                    <b>#@(index + 1)</b><strong>@entry.Name</strong>
                    <span>@entry.Type.ToUpperInvariant()</span>
                    <em>@entry.Score.ToString("N0")</em>
                </article>
            }
        </div>
        <div class="hall-publish">
            <strong>YOUR RUN · @Score.ToString("N0") POINTS</strong>
            <p>Scores sync automatically using your player name.</p>
            @if (!string.IsNullOrWhiteSpace(status)) { <small role="status">@status</small> }
        </div>
        <button class="hall-close" @onclick="CloseAsync">RETURN TO MY HUNT SUMMARY</button>
    </section>
</div>

@code {
    [Parameter] public int Score { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private IJSObjectReference? module;
    private readonly CancellationTokenSource refreshCancellation = new();
    private Task? refreshTask;
    private string status = "";
    private IReadOnlyList<HallEntry> entries = [];
    private sealed record HallEntry(string Name, int Score, string Type);
    private IReadOnlyList<HallEntry> SortedEntries => entries.Concat([new HallEntry("YOU · THIS RUN", Score, "yours")])
        .OrderByDescending(entry => entry.Score).ThenBy(entry => entry.Type == "yours" ? 0 : 1).Take(20).ToArray();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/leaderboard.js");
            var sync = await module.InvokeAsync<string>("flush");
            status = sync == "local" ? "Offline · saved scores will retry automatically." : sync == "rate_limited" ? "Sync delayed · saved scores will retry later." : "";
            var rows = await module.InvokeAsync<HallEntry[]>("load");
            entries = rows;
            refreshTask = RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException) { status = "Unable to load online scores. Your local result is still displayed."; await InvokeAsync(StateHasChanged); }
    }

    private async Task RefreshAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
            while (await timer.WaitForNextTickAsync(refreshCancellation.Token))
            {
                if (module is null) return;
                await module.InvokeAsync<string>("flush");
                entries = await module.InvokeAsync<HallEntry[]>("load");
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        await refreshCancellation.CancelAsync();
        if (refreshTask is not null) await refreshTask;
        if (module is not null) await module.DisposeAsync();
        refreshCancellation.Dispose();
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
