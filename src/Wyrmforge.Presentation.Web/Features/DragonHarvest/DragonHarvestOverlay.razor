@namespace Wyrmforge.Presentation.Web.Features.DragonHarvest

<div class="dragon-harvest">
    <section class="dragon-harvest-card">
        <div class="harvest-flow" aria-label="Wyrm harvest flow">
            <span class="done">1 • WYRM SLAIN</span>
            <span class="active">2 • CHOOSE ESSENCE</span>
            <span>3 • HOLD EVACUATION</span>
        </div>
        <div class="eyebrow">HARVEST @SourceName.ToUpperInvariant()</div>
        <h2>Take something that should have died with it.</h2>
        <p>Choose one part. Its power becomes active immediately, but the Essence itself is <strong>not safe yet</strong>.</p>
        <div class="harvest-risk"><span>⚠</span><div><strong>THE NEXT STEP IS THE RISK</strong><small>Choosing Essence starts an evacuation ritual. Stay inside the circle until it is secured at Refuge.</small></div></div>
        <div class="essence-choices">
            @foreach (var essence in Choices)
            {
                <button class="essence-choice" @onclick="() => ChooseAsync(essence.Id)">
                    <span class="essence-source">STOLEN FROM @essence.Source.ToUpperInvariant()</span>
                    <span class="essence-icon">@essence.Icon</span>
                    <strong>@essence.Name</strong>
                    <span class="essence-effect">@essence.Effect</span>
                    <small>@essence.Description</small>
                    <span class="essence-footer">TAKE ESSENCE • BEGIN EVACUATION</span>
                </button>
            }
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<DragonEssenceDefinition> Choices { get; set; } = Array.Empty<DragonEssenceDefinition>();

    [Parameter]
    public EventCallback<DragonEssenceId> OnChoose { get; set; }

    private string SourceName => Choices.FirstOrDefault()?.Source ?? "Wyrm";

    private Task ChooseAsync(DragonEssenceId id) => OnChoose.InvokeAsync(id);
}
