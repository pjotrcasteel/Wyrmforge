@using Wyrmforge.Domain.Progression.DragonEssences
@using Wyrmforge.Domain.Progression.Forge
@using Wyrmforge.Domain.Progression.SpellMastery

<section class="forge-goal-board @(Compact ? "compact" : string.Empty)" aria-label="Your next hunts">
    <header>
        <div>
            <span class="section-kicker">THE HUNT CONTINUES</span>
            <h2>Your next three pursuits</h2>
            <p>Recover Essence, forge new possibilities and awaken hidden spell lineages.</p>
        </div>
        <span class="forge-goal-count">@Progression.MasteryCount FORGED • @Masteries.UnlockedCount LINEAGES</span>
    </header>
    @if (Goals.Count == 0)
    {
        <p class="forge-goal-complete">All currently available Forge and Wyrmforged mastery goals have been completed. The Great Hunt will expand these pursuits.</p>
    }
    else
    {
        <div class="forge-goal-grid">
            @foreach (var goal in Goals)
            {
                <article class="forge-goal @(goal.Ready ? "ready" : string.Empty)">
                    <div class="forge-goal-status">@goal.Status • @goal.Progress / @goal.Required</div>
                    <h3>@goal.Title</h3>
                    <p>@goal.Objective</p>
                    <small>@goal.Reward</small>
                </article>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public ForgeProgressionState Progression { get; set; } = null!;
    [Parameter, EditorRequired] public DragonEssenceVault Vault { get; set; } = null!;
    [Parameter] public SpellMasteryState Masteries { get; set; } = new();
    [Parameter] public bool Compact { get; set; }

    private IReadOnlyList<HuntGoal> Goals
    {
        get
        {
            var forge = ForgeGoalPlanner.Next(Progression, Vault);
            var mastery = SpellMasteryGoalPlanner.Next(Masteries);
            var forgeCount = mastery.Count > 0 ? Math.Min(forge.Count, 2) : 3;
            var selected = forge.Take(forgeCount).Select(goal => new HuntGoal(goal.Title, goal.Objective, goal.Reward, goal.Progress,
                goal.Required, goal.ReadyToForge, goal.ReadyToForge ? "READY TO FORGE" : "NEXT HUNT")).ToList();
            selected.AddRange(mastery.Take(3 - selected.Count).Select(goal =>
                new HuntGoal(goal.Title, goal.Objective, goal.Reward, goal.Progress, goal.Required, false, "SPELL MASTERY")));
            if (selected.Count < 3) selected.AddRange(forge.Skip(forgeCount).Take(3 - selected.Count).Select(goal =>
                new HuntGoal(goal.Title, goal.Objective, goal.Reward, goal.Progress, goal.Required, goal.ReadyToForge, "NEXT HUNT")));
            return selected;
        }
    }

    private sealed record HuntGoal(string Title, string Objective, string Reward, int Progress, int Required, bool Ready, string Status);
}
