@using Wyrmforge.Domain.Combat.Dragons
@using Wyrmforge.Domain.Progression.DragonEssences
@using Wyrmforge.Domain.Spells
@using Wyrmforge.Domain.Spells.Composition
@using Wyrmforge.Domain.Progression.Laboratory
@using Wyrmforge.Domain.Progression.PassiveTree

<section class="lab-view" aria-label="Laboratory">
    @if (Notice is not null)
    {
        <div class="lab-notice" role="status"><span>@Notice</span><button aria-label="Dismiss" @onclick="() => OnDismissNotice.InvokeAsync()">×</button></div>
    }

    <nav class="lab-tabs" role="tablist" aria-label="Mutations">
        @foreach (var candidate in LaboratoryCatalog.Mutations)
        {
            var current = candidate.Id == Mutation.Id;
            <button role="tab" aria-selected="@current.ToString().ToLowerInvariant()" class="@(current ? "active" : string.Empty)" @onclick="() => Select(candidate.Id)">
                <i class="px-icon px-sm px-@SpellIcon(candidate.Foundation)" aria-hidden="true"></i>@candidate.Name<small>@TabState(candidate.Id)</small>
            </button>
        }
    </nav>

    <header class="lab-recipe @RecipeClass" aria-label="@Mutation.Name recipe">
        <div class="lab-kicker">MUTATION · @Mutation.Name.ToUpperInvariant()</div>
        <div class="lab-equation" aria-hidden="true">
            <span class="lab-glyph @FoundationIcon"><i class="px-icon px-lg px-@FoundationIcon"></i></span>
            <b>+</b>
            <span class="lab-glyph @SpecimenIcon"><i class="px-icon px-lg px-@SpecimenIcon"></i><i class="px-icon px-heart lab-glyph-badge"></i></span>
            <b>→</b>
            <span class="lab-glyph fused @FoundationIcon-@SpecimenIcon"><i class="px-icon px-lg px-@FoundationIcon"></i><i class="px-icon px-lg px-@SpecimenIcon"></i></span>
        </div>
        <p>@Mutation.Summary</p>
        <p class="lab-blueprint" aria-label="Blueprint">
            <span>@SpellCatalog.Get(Mutation.Foundation).Name</span>
            @foreach (var (_, component) in Mutation.Blueprint.Components())
            {
                <span>@SpellComponentCatalog.Get(component).Name</span>
            }
            <small title="Complexity used of the ruleset budget">Complexity @Mutation.Validation.Complexity/@Mutation.Validation.Budget</small>
        </p>
        <ol class="lab-pips" aria-label="@KnownCount of @Mutation.RequiresObservations.Count conditions understood">
            @foreach (var observation in Mutation.RequiresObservations)
            {
                <li class="@(Laboratory.HasObserved(observation) ? "known" : string.Empty)" title="@LaboratoryCatalog.ObservationLabel(observation)">@LaboratoryCatalog.ObservationLabel(observation)</li>
            }
        </ol>
        <div class="lab-specimen">
            <i class="px-icon px-sm px-@SpecimenIcon" aria-hidden="true"></i>
            <span>@Mutation.Specimen.Name × @Specimens</span>
            @if (Laboratory.NeedsSpecimen(Mutation.Id, Vault))
            {
                <small>@(IsTracked ? $"Tracked: {WyrmName} answers your next hunt." : $"Hunt {WyrmName} to bring back a specimen.")</small>
                <button class="lab-track @(IsTracked ? "tracked" : string.Empty)" aria-pressed="@IsTracked.ToString().ToLowerInvariant()" @onclick="ToggleTrackAsync">@(IsTracked ? "TRACKING" : $"TRACK {WyrmName.ToUpperInvariant()}")</button>
            }
            else
            {
                <small>Specimens are only studied; experiments never consume them.</small>
            }
        </div>
    </header>

    <section class="lab-bench" aria-label="Experiments">
        <h2>Experiments</h2>
        @foreach (var experiment in LaboratoryCatalog.ExperimentsFor(Mutation.Id))
        {
            var availability = Laboratory.Availability(experiment.Id, Vault);
            var known = availability == ExperimentAvailability.AlreadyRecorded;
            <article class="lab-experiment @OutcomeClass(experiment, known) @(lastResult?.Experiment.Id == experiment.Id ? "latest" : string.Empty)">
                <button disabled="@(availability is ExperimentAvailability.MissingObservation or ExperimentAvailability.MissingSample)" @onclick="() => RunAsync(experiment.Id)" aria-label="@(known ? $"Review {experiment.Name}" : $"Run {experiment.Name}")">
                    <span class="lab-experiment-state" aria-hidden="true">@StateGlyph(experiment, availability)</span>
                    <span class="lab-experiment-text">
                        <strong>@experiment.Name</strong>
                        <small>@(known ? OutcomeLabel(experiment.Outcome) : availability switch
                        {
                            ExperimentAvailability.MissingSample => $"Needs a {Mutation.Specimen.Name} in the vault",
                            ExperimentAvailability.MissingObservation => "Needs an earlier finding",
                            _ => experiment.Hypothesis,
                        })</small>
                    </span>
                </button>
                @if (known)
                {
                    <p class="lab-finding">@experiment.Finding</p>
                }
            </article>
        }
        @if (lastResult is { } result && result.Experiment.Mutation == Mutation.Id)
        {
            <div class="lab-result @(result.Novel ? "novel" : "repeat")" role="status" aria-live="polite">
                <strong>@(result.Novel ? OutcomeLabel(result.Experiment.Outcome) : "ALREADY RECORDED")</strong>
                <span>@result.Message</span>
                @if (result.Novel) { <small>Next: @result.Experiment.NextStep</small> }
            </div>
        }
    </section>

    <section class="lab-stabilize" aria-label="Stabilize and equip">
        @switch (Status)
        {
            case MutationResearchStatus.MissingObservations:
                <p class="lab-hint">Understand @(Mutation.RequiresObservations.Count - KnownCount) more condition@(Mutation.RequiresObservations.Count - KnownCount == 1 ? string.Empty : "s") to stabilize the mutation.</p>
                break;
            case MutationResearchStatus.MissingStabilizer:
                <p class="lab-hint">All conditions known. Stabilizing needs 1 secured @Mutation.Specimen.Name.</p>
                break;
            case MutationResearchStatus.ReadyToStabilize:
                @if (!confirming)
                {
                    <button class="lab-primary" @onclick="() => confirming = true">STABILIZE @Mutation.Name.ToUpperInvariant()</button>
                }
                else
                {
                    <div class="lab-consent" role="alertdialog" aria-label="Confirm Essence use">
                        <strong>Consume 1 @Mutation.Specimen.Name?</strong>
                        <span>Vault: @Specimens → @(Specimens - 1). The Forge uses the same @(Mutation.Specimen.Name)s.</span>
                        <span>Success is certain: every condition is understood. The recipe is kept forever.</span>
                        <div><button @onclick="() => confirming = false">CANCEL</button><button class="lab-primary" @onclick="StabilizeAsync">CONSUME &amp; STABILIZE</button></div>
                    </div>
                }
                break;
            case MutationResearchStatus.Stabilized:
                <h2>Sockets · @Laboratory.Slotted.Count/@LaboratoryCatalog.MaxEquippedMutations equipped</h2>
                @foreach (var socketId in Mutation.CompatibleSockets)
                {
                    var socket = LaboratoryCatalog.Get(socketId);
                    var holder = Laboratory.Slotted.TryGetValue(socketId, out var held) ? held : (LaboratoryMutationId?)null;
                    var check = Laboratory.CheckEquip(Mutation.Id, socketId, Selection.Selected);
                    var holdsThis = holder == Mutation.Id;
                    <div class="lab-socket @SocketClass(holdsThis, check)">
                        <i class="px-icon px-sm px-@(check == MutationEquipResult.SocketLocked ? "lock" : "rune")" aria-hidden="true"></i>
                        <span><strong>@socket.Name</strong><small>@SocketLine(socket, holder, holdsThis, check)</small></span>
                        @if (holdsThis)
                        {
                            <button class="equipped" aria-pressed="true" aria-label="@($"Unequip {Mutation.Name} from {socket.Name}")" @onclick="() => Equip(Mutation.Id, null)">UNEQUIP</button>
                        }
                        else if (check == MutationEquipResult.Equipped)
                        {
                            <button aria-label="@($"Equip {Mutation.Name} in {socket.Name}")" @onclick="() => Equip(Mutation.Id, socketId)">@(holder is null ? "EQUIP" : "SWAP")</button>
                        }
                        else if (check == MutationEquipResult.SocketLocked)
                        {
                            <button aria-label="@($"Open the Atlas to allocate {socket.NodeName}")" @onclick="() => OnOpenAtlas.InvokeAsync()">ATLAS</button>
                        }
                    </div>
                }
                <p class="lab-tradeoff">Active only when @SpellCatalog.Get(Mutation.Foundation).Name is your primary. @Mutation.TradeOff</p>
                break;
        }
        @if (Laboratory.FieldTests > 0)
        {
            <p class="lab-field-notes"><i class="px-icon px-sm px-book" aria-hidden="true"></i>Field notes: @Laboratory.FieldTests hunt@(Laboratory.FieldTests == 1 ? string.Empty : "s"), @Laboratory.FieldReactions reaction@(Laboratory.FieldReactions == 1 ? string.Empty : "s").</p>
        }
    </section>
</section>

@code {
    [Parameter, EditorRequired] public LaboratoryState Laboratory { get; set; } = null!;
    [Parameter, EditorRequired] public DragonEssenceVault Vault { get; set; } = null!;
    [Parameter, EditorRequired] public PassiveTreeSelection Selection { get; set; } = null!;
    [Parameter] public string? Notice { get; set; }
    [Parameter] public EventCallback OnDismissNotice { get; set; }
    [Parameter] public EventCallback OnOpenAtlas { get; set; }
    [Parameter, EditorRequired] public Func<LaboratoryExperimentId, Task<LaboratoryExperimentResult>> RunExperiment { get; set; } = null!;
    [Parameter, EditorRequired] public Func<LaboratoryMutationId, Task<bool>> Stabilize { get; set; } = null!;
    [Parameter, EditorRequired] public Func<LaboratoryMutationId, ArcaneMutationSocketId?, Task> Equip { get; set; } = null!;
    [Parameter] public Func<LaboratoryMutationId?, Task> Track { get; set; } = _ => Task.CompletedTask;
    [Parameter] public LaboratoryMutationId? Focus { get; set; }

    private LaboratoryMutationId selected = LaboratoryMutationId.RimeInfusion;
    private LaboratoryExperimentResult? lastResult;
    private bool confirming;

    private LaboratoryMutationDefinition Mutation => LaboratoryCatalog.Get(selected);
    private ArcaneMutationSocketDefinition Socket => LaboratoryCatalog.Get(Mutation.Socket);
    private string WyrmName => DragonCatalog.Get(Mutation.SpecimenWyrm).Name;
    private bool IsTracked => Laboratory.Tracked == Mutation.Id;
    private string FoundationIcon => SpellIcon(Mutation.Foundation);
    private string SpecimenIcon => WyrmIcon(Mutation.SpecimenWyrm);
    private int Specimens => Vault.Count(Mutation.Stabilizer);
    private int KnownCount => Mutation.RequiresObservations.Count(Laboratory.HasObserved);
    private MutationResearchStatus Status => Laboratory.Status(Mutation.Id, Vault);
    private string RecipeClass => Status == MutationResearchStatus.Stabilized ? "stabilized" : KnownCount > 0 ? "researching" : "unknown";

    // Open on whatever the player is pursuing: an explicit focus, else the tracked lead, else an equipped recipe.
    protected override void OnInitialized() =>
        selected = Focus ?? Laboratory.Tracked ?? Laboratory.EquippedMutations.Select(id => (LaboratoryMutationId?)id).FirstOrDefault() ?? LaboratoryMutationId.RimeInfusion;

    private void Select(LaboratoryMutationId id)
    {
        selected = id;
        confirming = false;
    }

    private string TabState(LaboratoryMutationId id) =>
        Laboratory.IsEquipped(id) ? "equipped"
        : Laboratory.Stabilized.Contains(id) ? "stabilized"
        : Laboratory.Tracked == id ? "tracked"
        : $"{LaboratoryCatalog.Get(id).RequiresObservations.Count(Laboratory.HasObserved)}/{LaboratoryCatalog.Get(id).RequiresObservations.Count}";

    private Task ToggleTrackAsync() => Track(IsTracked ? null : Mutation.Id);

    private static string SpellIcon(SpellId spell) => spell switch
    {
        SpellId.FireBolt => "fire",
        SpellId.ArcaneOrb => "arcane",
        SpellId.ChainLightning => "storm",
        _ => "frost",
    };

    private static string WyrmIcon(DragonId wyrm) => wyrm switch
    {
        DragonId.Ashfang => "fire",
        DragonId.Stormcoil => "storm",
        DragonId.Voidweaver => "arcane",
        _ => "frost",
    };

    private async Task RunAsync(LaboratoryExperimentId id) => lastResult = await RunExperiment(id);

    private async Task StabilizeAsync()
    {
        confirming = false;
        await Stabilize(Mutation.Id);
    }

    private static string SocketClass(bool holdsThis, MutationEquipResult check) =>
        holdsThis ? "ready equipped" : check == MutationEquipResult.Equipped ? "ready" : "locked";

    private string SocketLine(ArcaneMutationSocketDefinition socket, LaboratoryMutationId? holder, bool holdsThis, MutationEquipResult check) => holdsThis
        ? $"Equipped on the {socket.Route}."
        : check switch
        {
            MutationEquipResult.SocketLocked => $"Allocate {socket.NodeName} on the {socket.Route}.",
            MutationEquipResult.FoundationTaken => $"Another {SpellCatalog.Get(Mutation.Foundation).Name} mutation is equipped; only one can wake.",
            MutationEquipResult.SocketLimitReached => $"Both sockets are in use. Unequip one first.",
            MutationEquipResult.Equipped when holder is { } other => $"Holds {LaboratoryCatalog.Get(other).Name}. Swapping unequips it; its recipe is kept.",
            MutationEquipResult.Equipped => $"{socket.NodeName} is allocated on the {socket.Route}.",
            _ => "This socket cannot hold the blueprint.",
        };

    private static string OutcomeLabel(LaboratoryExperimentOutcome outcome) => outcome switch
    {
        LaboratoryExperimentOutcome.Insight => "INSIGHT",
        LaboratoryExperimentOutcome.InstructiveFailure => "FAILED, AND LEARNED WHY",
        _ => "DEAD END: RULED OUT",
    };

    private static string OutcomeClass(LaboratoryExperimentDefinition experiment, bool known) => !known ? "pending" : experiment.Outcome switch
    {
        LaboratoryExperimentOutcome.Insight => "insight",
        LaboratoryExperimentOutcome.InstructiveFailure => "failure",
        _ => "dead-end",
    };

    private static string StateGlyph(LaboratoryExperimentDefinition experiment, ExperimentAvailability availability) => availability switch
    {
        ExperimentAvailability.AlreadyRecorded => experiment.Outcome == LaboratoryExperimentOutcome.Insight ? "✓" : experiment.Outcome == LaboratoryExperimentOutcome.InstructiveFailure ? "!" : "✕",
        ExperimentAvailability.Ready => "?",
        _ => "·",
    };
}
