@using Wyrmforge.Domain.Combat.Dragons
@using Wyrmforge.Domain.Progression.Codex
@using Wyrmforge.Domain.Progression.Relics
@using Wyrmforge.Domain.Spells
@using Wyrmforge.Domain.Progression.Forge
@using Wyrmforge.Domain.Progression.SpellMastery
@using Wyrmforge.Domain.Progression.GreatHunt
@using Wyrmforge.Domain.Spells.Evolutions
@using Wyrmforge.Domain.Spells.Synergies

<section class="codex-view">
    <header class="codex-heading">
        <div>
            <span class="section-kicker">ARCANE CODEX</span>
            <h1>Know what the realm can become.</h1>
            <p>The Codex is reference and discovery, not a start screen. Unknown synergies stay hidden until you create them in a run.</p>
        </div>
        <div class="codex-count"><strong>@Codex.Count</strong><span>of @SynergyCatalog.All.Count synergies discovered</span></div>
    </header>

    <section class="codex-section">
        <div class="section-heading"><span class="section-kicker">DISCOVERED SYNERGIES</span></div>
        <div class="codex-grid">
            @foreach (var synergy in SynergyCatalog.All)
            {
                var discovered = Codex.Contains(synergy.Id);
                <article class="codex-card @(discovered ? "known" : "unknown")">
                    <span class="codex-icon">@(discovered ? synergy.Icon : "?")</span>
                    <div><strong>@(discovered ? synergy.Name : "Unknown synergy")</strong><small>@(discovered ? synergy.Description : "Create new combinations in the Wyrmrealm to reveal this entry.")</small></div>
                </article>
            }
        </div>
    </section>

    <section class="codex-section lineage-codex">
        <div class="section-heading">
            <span class="section-kicker">WYRMFORGED SPELL LINEAGES</span>
            <small>@Masteries.UnlockedCount / @SpellLineageCatalog.All.Count awakened</small>
        </div>
        <p class="lineage-codex-guide">Master a spell across meaningful hunts, then defeat its Wyrm with the spell at Rank III. The reward is a new evolution branch forever available in future runs.</p>
        <div class="codex-grid lineage-codex-grid">
            @foreach (var lineage in SpellLineageCatalog.All)
            {
                var progress = Masteries.Get(lineage.Spell);
                var spell = SpellCatalog.Get(lineage.Spell);
                var wyrm = DragonCatalog.Get(lineage.Wyrm);
                var awakened = progress.Unlocked;
                var evolution = SpellEvolutionCatalog.Get(lineage.Evolution);
                <article class="codex-card @(awakened ? "known" : "unknown-lineage")">
                    <span class="codex-icon">@(awakened ? evolution.Icon : spell.Icon)</span>
                    <div>
                        <strong>@(awakened ? evolution.Name : $"{spell.Name} • unknown lineage")</strong>
                        <small>@lineage.Clue</small>
                        <div class="lineage-codex-progress">
                            <span class="@(progress.MeaningfulRuns >= lineage.RequiredRuns ? "done" : string.Empty)">@(Math.Min(progress.MeaningfulRuns, lineage.RequiredRuns)) / @lineage.RequiredRuns meaningful hunts</span>
                            <span class="@(progress.WyrmFeat ? "done" : string.Empty)">@(progress.WyrmFeat ? "✓" : "◇") @wyrm.Name with Rank III @spell.Name</span>
                        </div>
                        @if (awakened)
                        {
                            <small class="lineage-reward">AWAKENED • @evolution.Description</small>
                        }
                        else
                        {
                            <small class="lineage-reward">REWARD • undiscovered evolution</small>
                        }
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="codex-section">
        <div class="section-heading"><span class="section-kicker">THE GREAT HUNT</span><small>@Hunt.CompletedCount(Masteries) / 4 oaths sealed</small></div>
        <GreatHuntPanel Hunt="Hunt" Masteries="Masteries" />
    </section>

    <section class="codex-section">
        <div class="section-heading"><span class="section-kicker">SPELLS</span><small>@SpellCatalog.All.Count known designs</small></div>
        <div class="codex-grid compact">
            @foreach (var spell in SpellCatalog.All)
            {
                var evolutions = SpellEvolutionCatalog.For(spell.Id);
                <article class="codex-card">
                    <span class="codex-icon">@spell.Icon</span>
                    <div>
                        <strong>@spell.Name</strong>
                        <small>@spell.Description</small>
                        <small>Rank III → @string.Join(" / ", evolutions.Select(evolution => evolution.RequiresForgeUnlock && !Progression.UnlocksEvolution(evolution.Id) ? "🔒 Forge blueprint"
                            : evolution.RequiresMasteryUnlock && !Masteries.Unlocks(evolution.Id) ? "◇ Hidden lineage"
                            : $"{evolution.Icon} {evolution.Name}"))</small>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="codex-section">
        <div class="section-heading"><span class="section-kicker">RELICS</span><small>@RelicCatalog.All.Count known relics</small></div>
        <div class="codex-grid compact">
            @foreach (var relic in RelicCatalog.All)
            {
                <article class="codex-card"><span class="codex-icon">@relic.Icon</span><div><strong>@relic.Name</strong><small>@relic.Description</small></div></article>
            }
        </div>
    </section>

    <section class="codex-section">
        <div class="section-heading"><span class="section-kicker">WYRM DOSSIERS</span><small>@DragonCatalog.All.Count known Wyrms</small></div>
        <div class="codex-grid compact">
            @foreach (var dragon in DragonCatalog.All)
            {
                <article class="codex-card wyrm-card"><span class="codex-icon">◈</span><div><strong>@dragon.Name</strong><small>@dragon.Title • @dragon.School</small></div></article>
            }
        </div>
    </section>

    <a class="combat-lab-link" href="combat-lab">Open developer Combat Lab</a>
</section>

@code {
    [Parameter, EditorRequired] public ArcaneCodex Codex { get; set; } = null!;
    [Parameter, EditorRequired] public ForgeProgressionState Progression { get; set; } = null!;
    [Parameter] public SpellMasteryState Masteries { get; set; } = new();
    [Parameter] public GreatHuntState Hunt { get; set; } = new();
}
