@using Microsoft.JSInterop
@inject IJSRuntime JavaScript
@using Wyrmforge.Domain.Progression.Codex
@using Wyrmforge.Domain.Progression.Forge
@using Wyrmforge.Domain.Progression.SpellMastery
@using Wyrmforge.Domain.Progression.GreatHunt
@using Wyrmforge.Domain.Combat.Dragons
@using Wyrmforge.Domain.Progression.Onboarding
@using Wyrmforge.Domain.Progression.Experience
@using Wyrmforge.Domain.Progression.Laboratory
@using Wyrmforge.Domain.Progression.Loadouts

<main class="game-shell @(section == ShellSection.Run ? "menu-home" : string.Empty)">
    @if (section == ShellSection.Run)
    {
        <div class="hub-backdrop" aria-hidden="true"><div class="hub-rain"></div></div>
    }
    @if (section != ShellSection.Run)
    {
        <header class="menu-header">
            <button class="menu-back" aria-label="@(section == ShellSection.Laboratory && ForgeUnlocked ? "Back to Forge" : "Back to main menu")" @onclick="() => Navigate(section == ShellSection.Laboratory && ForgeUnlocked ? ShellSection.Forge : ShellSection.Run)">‹</button>
            <h1>@SectionTitle</h1>
        </header>
    }
    <section class="shell-content">
        @switch (section)
        {
            case ShellSection.Run:
                <div class="player-identity">
                    <button class="player-name-edit" aria-label="Edit player name" @onclick="OpenNameEditor">
                        <span>@PlayerName</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 16 12-12 4 4-12 12-5 1Z M14 6l4 4" /></svg>
                    </button>
                    <small>Public nickname</small>
                </div>
                @if (editingName)
                {
                    <div class="name-editor-backdrop">
                        <form class="name-editor" role="dialog" aria-modal="true" aria-label="Edit player name" @onsubmit="SaveNameAsync" @onsubmit:preventDefault>
                            <label for="player-name">PLAYER NAME</label>
                            <input id="player-name" aria-label="Player name" maxlength="18" @bind="nameDraft" autofocus autocomplete="nickname" />
                            @if (nameError is not null) { <small class="name-error" role="alert">@nameError</small> }
                            <small>Used on the public leaderboard.</small>
                            <div><button type="button" @onclick="() => editingName = false">CANCEL</button><button type="submit">SAVE</button></div>
                        </form>
                    </div>
                }
                <section class="main-menu" aria-label="Main menu">
                    <header class="menu-brand"><span class="menu-sigil" aria-hidden="true">W</span><h1>WYRMFORGE</h1>
                        @if (Progress.AtlasUnlocked)
                        {
                            <button class="hunter-menu-progress" @onclick="() => OnQuests.InvokeAsync()"><span>HUNTER @Hunter.Level</span><span>@(Hunter.AtCap ? "Atlas complete" : $"{Hunter.ExperienceInLevel} / {Hunter.ExperienceToNext} XP")</span></button>
                        }</header>
                    <nav class="menu-actions" aria-label="Wyrmforge navigation">
                        <button class="menu-begin" @onclick="StartAsync">@(Progress.TutorialRun ? "BEGIN FIRST HUNT" : "BEGIN HUNT")<span aria-hidden="true">›</span></button>
                        @foreach (var item in Navigation.Where(item => item.Section is not ShellSection.Run and not ShellSection.Laboratory))
                        {
                            var unlocked = IsUnlocked(item.Section);
                            <button class="menu-destination" disabled="@(!unlocked)" aria-label="@(item.Section == ShellSection.Build && unlocked && Selection.PointBudget > Selection.SpentPoints ? "Allocate unspent Arcane points" : item.Label)" @onclick="() => Navigate(item.Section)">
                                <span><i class="px-icon px-sm px-@item.Icon" aria-hidden="true"></i>@item.Label</span>
                                <small>@(!unlocked ? $"◇ {UnlockHint(item.Section)}" : item.Section == ShellSection.Build ? $"{Selection.PointBudget - Selection.SpentPoints} points" : item.Section == ShellSection.Forge ? $"{Vault.TotalCount} Essence" : string.Empty)</small>
                            </button>
                        }
                        <button class="menu-destination" disabled="@(!Progress.LeaderboardUnlocked)" aria-label="Open Hall of Fame" @onclick="() => OnLeaderboard.InvokeAsync()"><span><i class="px-icon px-sm px-crown" aria-hidden="true"></i>Hall of Fame</span><small>@(Progress.LeaderboardUnlocked ? BestScore.ToString("N0") : "◇ Finish two hunts")</small></button>
                    </nav>
                    <footer class="menu-footer">
                        @if (!Progress.TutorialRun)
                        {
                            <button @onclick="() => Navigate(ShellSection.Prepare)">Hunt preparation</button>
                            <button @onclick="() => OnQuests.InvokeAsync()">Quests@(QuestRewards > 0 ? $" · {QuestRewards}" : string.Empty)</button>
                        }
                        <button aria-label="More options" @onclick="() => Navigate(ShellSection.Options)">•••</button>
                    </footer>
                </section>
                break;
            case ShellSection.Build:
                @if (IsUnlocked(ShellSection.Laboratory))
                {
                    <BuildView Selection="Selection" OnSelectionChanged="OnSelectionChanged" OnQuests="OnQuests" Loadouts="Loadouts" SaveLoadout="SaveLoadout" ApplyLoadout="ApplyLoadout" ClearLoadout="ClearLoadout"
                        Laboratory="Laboratory" Vault="Vault" Notice="@LaboratoryNotice" OnDismissNotice="OnDismissLaboratoryNotice" FocusNodeId="@nexusFocus"
                        RunExperiment="RunExperiment" Stabilize="StabilizeMutation" Equip="EquipMutation" Track="TrackMutation" />
                }
                else
                {
                    <BuildView Selection="Selection" OnSelectionChanged="OnSelectionChanged" OnQuests="OnQuests" Loadouts="Loadouts" SaveLoadout="SaveLoadout" ApplyLoadout="ApplyLoadout" ClearLoadout="ClearLoadout" />
                }
                break;
            case ShellSection.Forge:
                @if (IsUnlocked(ShellSection.Laboratory))
                {
                    <button class="forge-lab-entry" aria-label="Open Laboratory" @onclick="() => Navigate(ShellSection.Laboratory)">
                        <span><i class="px-icon px-sm px-flask" aria-hidden="true"></i>Laboratory</span>
                        <small>@LaboratoryStatus ›</small>
                    </button>
                }
                <ForgeProgressionView Vault="Vault" Progression="Progression" Masteries="Masteries" Hunt="Hunt" SelectedOffering="SelectedOffering" OnOfferingChanged="SelectOfferingAsync" OnForgeMastery="ForgeAsync" OnPrepareHunt="() => NavigateAsync(ShellSection.Run)" />
                break;
            case ShellSection.Laboratory:
                <LaboratoryView Laboratory="Laboratory" Vault="Vault" Selection="Selection" Notice="@LaboratoryNotice" OnDismissNotice="OnDismissLaboratoryNotice" OnOpenAtlas="() => NavigateAsync(ShellSection.Build)" RunExperiment="RunExperiment" Stabilize="StabilizeMutation" Equip="EquipMutation" Track="TrackMutation" Focus="LaboratoryFocus" />
                break;
            case ShellSection.Codex:
                <CodexView Codex="Codex" Bestiary="Bestiary" Progression="Progression" Masteries="Masteries" Hunt="Hunt" />
                break;
            case ShellSection.Prepare:
                <RunHubView RewardCaches="RewardCaches" AtlasUnlocked="Progress.AtlasUnlocked" Selection="Selection" Vault="Vault" Progression="Progression" Masteries="Masteries" Hunt="Hunt" SelectedOffering="SelectedOffering" BestScore="BestScore" AscendantSelected="AscendantSelected" OnAscendantChanged="OnAscendantChanged" OnStart="StartAsync" OnFeedback="OnFeedback" LeaderboardUnlocked="Progress.LeaderboardUnlocked" OnLeaderboard="OnLeaderboard" OnEditBuild="() => NavigateAsync(ShellSection.Build)" Laboratory="@(IsUnlocked(ShellSection.Laboratory) ? Laboratory : null)" OnEditForge="() => NavigateAsync(ShellSection.Forge)" ForgeUnlocked="ForgeUnlocked" />
                break;
            case ShellSection.Options:
                <div class="menu-options"><button @onclick="() => OnFeedback.InvokeAsync()">Feedback</button><a href="combat-lab">Developer Combat Lab</a></div>
                break;
        }
    </section>
</main>

@code {
    [Parameter] public string PlayerName { get; set; } = "Wyrm Wanderer";
    [Parameter] public EventCallback<string> OnPlayerNameChanged { get; set; }
    [Parameter, EditorRequired] public PassiveTreeSelection Selection { get; set; } = null!;
    [Parameter, EditorRequired] public FirstHuntProgress Progress { get; set; } = null!;
    [Parameter] public bool ForgeUnlocked { get; set; }
    [Parameter] public EventCallback OnSelectionChanged { get; set; }
    [Parameter] public EventCallback OnLeaderboard { get; set; }
    [Parameter, EditorRequired] public DragonEssenceVault Vault { get; set; } = null!;
    [Parameter, EditorRequired] public ArcaneCodex Codex { get; set; } = null!;
    [Parameter] public Wyrmforge.Domain.Progression.Bestiary.BestiaryState Bestiary { get; set; } = new();
    [Parameter, EditorRequired] public ForgeProgressionState Progression { get; set; } = null!;
    [Parameter] public SpellMasteryState Masteries { get; set; } = new();
    [Parameter] public GreatHuntState Hunt { get; set; } = new();
    [Parameter] public DragonEssenceId? SelectedOffering { get; set; }
    [Parameter] public DragonId? AscendantSelected { get; set; }
    [Parameter] public EventCallback<DragonId?> OnAscendantChanged { get; set; }
    [Parameter] public int BestScore { get; set; }
    [Parameter] public EventCallback<DragonEssenceId> OnOfferingChanged { get; set; }
    [Parameter] public EventCallback<ForgeMasteryId> OnForgeMastery { get; set; }
    [Parameter] public EventCallback OnStart { get; set; }
    [Parameter] public EventCallback OnFeedback { get; set; }
    [Parameter] public EventCallback OnQuests { get; set; }
    [Parameter] public int QuestRewards { get; set; }
    [Parameter] public int RewardCaches { get; set; }
    [Parameter] public HunterProgress Hunter { get; set; } = new();
    [Parameter] public LaboratoryState Laboratory { get; set; } = new();
    [Parameter] public string? LaboratoryNotice { get; set; }
    [Parameter] public EventCallback OnDismissLaboratoryNotice { get; set; }
    [Parameter] public Func<LaboratoryExperimentId, Task<LaboratoryExperimentResult>> RunExperiment { get; set; } = _ => throw new InvalidOperationException("Laboratory not wired.");
    [Parameter] public Func<LaboratoryMutationId, Task<bool>> StabilizeMutation { get; set; } = _ => Task.FromResult(false);
    [Parameter] public Func<LaboratoryMutationId, ArcaneMutationSocketId?, Task> EquipMutation { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public Func<LaboratoryMutationId?, Task> TrackMutation { get; set; } = _ => Task.CompletedTask;
    [Parameter] public HuntLoadoutBook? Loadouts { get; set; }
    [Parameter] public Func<int, Task> SaveLoadout { get; set; } = _ => Task.CompletedTask;
    [Parameter] public Func<int, Task<HuntLoadoutApplyResult?>> ApplyLoadout { get; set; } = _ => Task.FromResult<HuntLoadoutApplyResult?>(null);
    [Parameter] public Func<int, Task> ClearLoadout { get; set; } = _ => Task.CompletedTask;
    [Parameter] public bool StartInLaboratory { get; set; }
    [Parameter] public LaboratoryMutationId? LaboratoryFocus { get; set; }

    private bool editingName;
    private string nameDraft = "";
    private string? nameError;
    private void OpenNameEditor() { nameDraft = PlayerName; nameError = null; editingName = true; }
    private async Task SaveNameAsync()
    {
        var policy = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/name-policy.js");
        try
        {
            nameError = await policy.InvokeAsync<string?>("validateName", nameDraft);
            if (nameError is not null) return;
            await OnPlayerNameChanged.InvokeAsync(nameDraft.Trim());
            editingName = false;
        }
        finally { await policy.DisposeAsync(); }
    }

    private ShellSection section = ShellSection.Run;
    private string? nexusFocus;
    private static readonly NavigationItem[] Navigation =
    [
        new(ShellSection.Run, "sword", "Run"),
        new(ShellSection.Build, "rune", "Arcane Nexus"),
        new(ShellSection.Forge, "anvil", "Forge"),
        new(ShellSection.Laboratory, "flask", "Laboratory"),
        new(ShellSection.Codex, "book", "Codex"),
    ];

    private string SectionTitle => section == ShellSection.Prepare ? "Hunt preparation" : section == ShellSection.Options ? "Options" : Navigation.Single(item => item.Section == section).Label;
    private bool IsUnlocked(ShellSection value) => value switch
    {
        ShellSection.Run or ShellSection.Prepare or ShellSection.Options => true,
        ShellSection.Build => Progress.AtlasUnlocked,
        ShellSection.Codex or ShellSection.Laboratory => Progress.CodexUnlocked,
        ShellSection.Forge => ForgeUnlocked,
        _ => false,
    };
    private string NavHelp(ShellSection value) => IsUnlocked(value) ? value.ToString() : value switch
    {
        ShellSection.Build => "Arcane Nexus locked until your First Hunt ends",
        ShellSection.Codex => "Codex locked until your First Hunt ends",
        ShellSection.Laboratory => "Laboratory locked until your First Hunt ends",
        ShellSection.Forge => "Forge locked until you bring back your first secured Essence",
        _ => "Locked",
    };
    private void Navigate(ShellSection value) { if (!IsUnlocked(value)) return; section = value; nexusFocus = null; }
    private Task NavigateAsync(ShellSection value) { Navigate(value); return Task.CompletedTask; }
    private Task SelectOfferingAsync(DragonEssenceId id) => OnOfferingChanged.InvokeAsync(id);
    private Task ForgeAsync(ForgeMasteryId id) => OnForgeMastery.InvokeAsync(id);
    private Task StartAsync() => OnStart.InvokeAsync();
    private string UnlockHint(ShellSection value) => value == ShellSection.Forge ? "Secure Essence" : "Finish first hunt";

    private string LaboratoryStatus => Laboratory.EquippedMutations.Count > 0 ? $"{string.Join(" + ", Laboratory.EquippedMutations.Select(id => LaboratoryCatalog.Get(id).Name))} equipped"
        : LaboratoryAdvisor.Next(Laboratory, Vault, Selection.Selected) is not { } prompt ? $"{Laboratory.Observations.Count} findings"
        : prompt.Kind switch
        {
            LaboratoryPromptKind.Stabilize => "Ready to stabilize",
            LaboratoryPromptKind.Experiment => "New experiment",
            LaboratoryPromptKind.Equip or LaboratoryPromptKind.UnlockSocket => "Recipe ready",
            _ when Laboratory.Tracked is { } tracked => $"Tracking {DragonCatalog.Get(LaboratoryCatalog.Get(tracked).SpecimenWyrm).Name}",
            _ => $"Needs a {LaboratoryCatalog.Get(prompt.Mutation).Specimen.Name}",
        };

    protected override void OnInitialized()
    {
        if (!StartInLaboratory || !IsUnlocked(ShellSection.Laboratory)) return;
        // A post-hunt research prompt opens the Arcane Nexus on the node that hosts the recipe (amendment §3).
        if (IsUnlocked(ShellSection.Build))
        {
            var mutation = LaboratoryFocus ?? Laboratory.Tracked ?? LaboratoryMutationId.RimeInfusion;
            nexusFocus = LaboratoryCatalog.Get(LaboratoryCatalog.Get(mutation).Socket).NodeId;
            section = ShellSection.Build;
        }
        else section = ShellSection.Laboratory;
    }

    private enum ShellSection { Run, Build, Forge, Laboratory, Codex, Prepare, Options }
    private sealed record NavigationItem(ShellSection Section, string Icon, string Label);
}
