@using Wyrmforge.Application.World
@implements IDisposable

@* Keep the constantly moving citizens in their own render subtree. The approved
   panorama, vacant layers, hotspots and static geometry no longer rerender at 10 Hz. *@
<div class="refuge-town-crowd refuge-town-crowd--behind" aria-hidden="true">
    @foreach (var person in Crowd.Citizens)
    {
        @if (person.IsPresent && IsBehindWell(person))
        {
            <span @key="person.Id" class="refuge-town-citizen" data-town-citizen-id="@person.Id"
                  data-town-depth="behind-well"
                  data-town-citizen-state="@CitizenState(person)"
                  data-town-work-building="@person.WorkBuildingId"
                  style="@CitizenStyle(person)"></span>
        }
    }
</div>
<div class="refuge-town-crowd refuge-town-crowd--front" aria-hidden="true">
    @foreach (var person in Crowd.Citizens)
    {
        @if (person.IsPresent && !IsBehindWell(person))
        {
            <span @key="person.Id" class="refuge-town-citizen" data-town-citizen-id="@person.Id"
                  data-town-depth="in-front"
                  data-town-citizen-state="@CitizenState(person)"
                  data-town-work-building="@person.WorkBuildingId"
                  style="@CitizenStyle(person)"></span>
        }
    }
</div>
@if (ShowGeometry)
{
    <svg class="refuge-town-geometry-feet-layer" viewBox="0 0 1672 941"
         preserveAspectRatio="none" aria-hidden="true">
        @foreach (var person in Crowd.Citizens)
        {
            @if (person.IsPresent)
            {
                <circle @key="person.Id" class="refuge-town-geometry-feet"
                        data-town-feet="@person.Id" cx="@person.Position.X"
                        cy="@person.Position.Y" r="@Crowd.Navigation.FootRadius" />
            }
        }
    </svg>
}

@code {
    [Parameter, EditorRequired] public TownCrowd Crowd { get; set; } = null!;
    [Parameter] public bool ShowGeometry { get; set; }
    [Parameter] public EventCallback GeometryChanged { get; set; }

    private readonly CancellationTokenSource crowdStop = new();
    private int lastGeometryRevision;

    protected override void OnInitialized()
    {
        lastGeometryRevision = Crowd.Navigation.Revision;
        _ = AnimateCrowdAsync();
    }

    private async Task AnimateCrowdAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        try
        {
            while (await timer.WaitForNextTickAsync(crowdStop.Token))
            {
                await InvokeAsync(() => { Crowd.Step(TimeSpan.FromMilliseconds(100)); StateHasChanged(); });
                if (!ShowGeometry || lastGeometryRevision == Crowd.Navigation.Revision) continue;

                // Dynamic props can change the map. Repaint the static collision
                // layer only for that revision, never for ordinary actor ticks.
                lastGeometryRevision = Crowd.Navigation.Revision;
                await GeometryChanged.InvokeAsync();
            }
        }
        catch (OperationCanceledException) { /* The town actor layer was disposed. */ }
    }

    private static string CitizenState(TownCitizen citizen) =>
        citizen.IsWorking ? "working" : citizen.IsWalking ? "walking" : "idling";

    private bool IsBehindWell(TownCitizen person)
    {
        var well = Crowd.Navigation.Occluders.FirstOrDefault(layer => layer.Id == "well-foreground");
        // Sort by the contact point, not whether the sprite rectangle touches a roof.
        return well is not null && person.Position.Y < well.DepthY;
    }

    private static string CitizenStyle(TownCitizen citizen) =>
        FormattableString.Invariant($"left:{citizen.XPercent:0.###}%;top:{citizen.YPercent:0.###}%");

    public void Dispose()
    {
        crowdStop.Cancel();
        crowdStop.Dispose();
    }
}
