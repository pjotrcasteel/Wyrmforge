@using Wyrmforge.Application.World
@using System.Net.Http
@using System.Text.Json
@inject NavigationManager Navigation
@inject ILogger<CanonicalTownView> Logger
@implements IDisposable
@* Night town vacancy follows actual game progress, not a local preview toggle. *@
<div class="refuge-canonical-viewport" role="region" tabindex="0"
     aria-label="Refuge town: swipe between West, World Gate and East">
    <div class="refuge-canonical-scene" aria-label="Night-time Refuge town square">
        <img class="refuge-town-night-base" src="art/town/night-active.webp?v=140"
             alt="" draggable="false" fetchpriority="high" />

        @if (!NexusUnlocked)
        {
            <img class="refuge-town-vacant-layer" src="art/town/night-vacant-ArcaneNexus.png?v=140"
                 style="left:0%;top:0%;width:36.9617%;height:61.8491%" alt="" draggable="false" />
        }
        @if (!ForgeUnlocked)
        {
            <img class="refuge-town-vacant-layer" src="art/town/night-vacant-Blacksmith.png?v=140"
                 style="left:0%;top:37.5133%;width:37.8589%;height:62.4867%" alt="" draggable="false" />
        }
        @if (!CodexUnlocked)
        {
            <img class="refuge-town-vacant-layer" src="art/town/night-vacant-Codex.png?v=140"
                 style="left:58.7321%;top:0%;width:41.2679%;height:58.2359%" alt="" draggable="false" />
        }
        @if (!HallUnlocked)
        {
            <img class="refuge-town-vacant-layer" src="art/town/night-vacant-HallOfFame.png?v=140"
                 style="left:51.7943%;top:35.3880%;width:48.2057%;height:64.6120%" alt="" draggable="false" />
        }

        @if (crowd is not null)
        {
            <RefugeTownActors Crowd="crowd" ShowGeometry="showTownGeometry"
                              ShowMetrics="showTownMetrics" GeometryChanged="OnGeometryChanged" />
        }

        @* Reuse small, clipped regions of the approved panorama. Only the painted
           object—not its surrounding pavement—can cover a citizen behind it. *@
        @if (crowd is not null)
        {
            @foreach (var foreground in crowd.Navigation.Occluders)
            {
                var minX = foreground.Clip.Min(point => point.X) - 1;
                var minY = foreground.Clip.Min(point => point.Y) - 1;
                var maxX = foreground.Clip.Max(point => point.X) + 1;
                var maxY = foreground.Clip.Max(point => point.Y) + 1;
                var bounds = FormattableString.Invariant(
                    $"{minX:0.##} {minY:0.##} {maxX - minX:0.##} {maxY - minY:0.##}");
                var foregroundStyle =
                    FormattableString.Invariant(
                        $"left:{minX / crowd.Navigation.Width * 100:0.###}%;top:{minY / crowd.Navigation.Height * 100:0.###}%;") +
                    FormattableString.Invariant(
                        $"width:{(maxX - minX) / crowd.Navigation.Width * 100:0.###}%;") +
                    FormattableString.Invariant(
                        $"height:{(maxY - minY) / crowd.Navigation.Height * 100:0.###}%;") +
                    FormattableString.Invariant($"z-index:{(int)MathF.Floor(foreground.DepthY * 10f)}");
                var maskId = $"refuge-foreground-{foreground.Id}";
                <svg @key="foreground.Id" class="refuge-town-scenery-foreground"
                     data-town-foreground-layer="@foreground.Id"
                     viewBox="@bounds" style="@foregroundStyle"
                     preserveAspectRatio="none" aria-hidden="true">
                    <defs>
                        <clipPath id="@maskId" clipPathUnits="userSpaceOnUse">
                            @if (foreground.Id == "noticeboard-foreground")
                            {
                                <path d="M715 449 L724 439 L738 431 L794 414 L807 418 L810 438
                                         L795 442 L795 491 L793 536 L785 539 L782 490
                                         L744 500 L747 544 L732 544 L729 499 L715 503 Z" />
                            }
                            else if (foreground.Id == "well-foreground")
                            {
                                <path d="M812 432 L826 412 L839 401 L840 389 L851 393 L857 401 L878 402
                                         L901 413 L919 429 L931 444 L925 467 L904 468 L819 465 Z" />
                                <path d="M825 458 L837 458 L836 523 L824 523 Z M900 457 L913 459 L914 519 L900 519 Z" />
                                <path d="M710 512 L740 500 L785 494 L889 495 L926 506 L942 520 L944 541
                                         L924 555 L889 563 L762 566 L724 559 L704 544 L702 528 Z" />
                            }
                            else
                            {
                                <polygon points="@GeometryPoints(foreground.Clip)" />
                            }
                        </clipPath>
                    </defs>
                    <image x="0" y="0" width="@crowd.Navigation.Width" height="@crowd.Navigation.Height"
                           preserveAspectRatio="none" href="@foreground.Artwork"
                           clip-path="@($"url(#{maskId})")" />
                </svg>
            }
        }

        @* Optional foot-radius scan exposes the navigation model over the actual artwork. *@
        @if (showTownWalkScan && !string.IsNullOrEmpty(walkScanPath))
        {
            <svg class="refuge-town-walk-scan" viewBox="0 0 1672 941"
                 preserveAspectRatio="none" aria-hidden="true" data-town-walk-scan="true">
                <path d="@walkScanPath" />
            </svg>
        }

        @* Developer-only overlay. The red shapes are the exact colliders used by pathfinding. *@
        @if (showTownGeometry && crowd is not null)
        {
            <div class="refuge-town-geometry-debug" data-town-geometry-debug="true" data-town-geometry-layer="@geometryLayer" aria-hidden="true">
                <svg viewBox="0 0 1672 941" preserveAspectRatio="none" class="refuge-town-geometry-map">
                    @if (geometryLayer is TownGeometryLayer.All or TownGeometryLayer.Walkable)
                    {
                        @* Walkable pavement excludes ground obstructions in BOTH the All and Walk views. *@
                        <defs>
                            <mask id="refuge-town-unblocked-mask" maskUnits="userSpaceOnUse" maskContentUnits="userSpaceOnUse"
                                  x="0" y="0" width="1672" height="941">
                                <rect x="0" y="0" width="1672" height="941" fill="white" />
                                @foreach (var obstacle in crowd.Navigation.Obstacles)
                                {
                                    <polygon fill="black" points="@GeometryPoints(obstacle.Footprint)" />
                                }
                            </mask>
                        </defs>
                    }
                    @if (geometryLayer is TownGeometryLayer.All or TownGeometryLayer.Walkable)
                    {
                        <g mask="url(#refuge-town-unblocked-mask)">
                            @foreach (var floor in crowd.Navigation.Walkable)
                            {
                                <polygon class="refuge-town-geometry-walkable" data-town-floor="@floor.Id"
                                         points="@GeometryPoints(floor.Points)" />
                            }
                        </g>
                    }
                    @if (geometryLayer is TownGeometryLayer.All or TownGeometryLayer.Blocked)
                    {
                        @foreach (var obstacle in crowd.Navigation.Obstacles)
                        {
                            <polygon @key="obstacle.Id" class="refuge-town-geometry-solid"
                                     data-town-obstacle="@obstacle.Id" points="@GeometryPoints(obstacle.Footprint)" />
                        }
                    }
                    @if (geometryLayer is TownGeometryLayer.All or TownGeometryLayer.Occlusion)
                    {
                        @foreach (var foreground in crowd.Navigation.Occluders)
                        {
                            <polygon @key="foreground.Id" class="refuge-town-geometry-visual"
                                     data-town-foreground="@foreground.Id" points="@GeometryPoints(foreground.Clip)" />
                        }
                    }
                </svg>
            </div>
        }

        <button type="button" class="refuge-town-spot refuge-town-spot--nexus"
                data-town-building="build" data-town-state="@(TownBuildingVisuals.StateName(NexusUnlocked))"
                data-sound-cue="@(NexusUnlocked ? "building-open" : "none")" title="@BuildingLabel("Arcane Nexus", NexusUnlocked)"
                aria-label="@BuildingLabel("Arcane Nexus", NexusUnlocked)" @onclick='() => OnBuilding.InvokeAsync("build")'></button>
        <button type="button" class="refuge-town-spot refuge-town-spot--blacksmith"
                data-town-building="forge" data-town-state="@(TownBuildingVisuals.StateName(ForgeUnlocked))"
                data-sound-cue="@(ForgeUnlocked ? "building-open" : "none")" title="@BuildingLabel("Blacksmith", ForgeUnlocked)"
                aria-label="@BuildingLabel("Blacksmith", ForgeUnlocked)" @onclick='() => OnBuilding.InvokeAsync("forge")'></button>
        <button type="button" class="refuge-town-spot refuge-town-spot--codex"
                data-town-building="codex" data-town-state="@(TownBuildingVisuals.StateName(CodexUnlocked))"
                data-sound-cue="@(CodexUnlocked ? "building-open" : "none")" title="@BuildingLabel("Codex", CodexUnlocked)"
                aria-label="@BuildingLabel("Codex", CodexUnlocked)" @onclick='() => OnBuilding.InvokeAsync("codex")'></button>
        <button type="button" class="refuge-town-spot refuge-town-spot--hall"
                data-town-building="legends" data-town-state="@(TownBuildingVisuals.StateName(HallUnlocked))"
                data-sound-cue="@(HallUnlocked ? "building-open" : "none")" title="@BuildingLabel("Hall of Fame", HallUnlocked)"
                aria-label="@BuildingLabel("Hall of Fame", HallUnlocked)" @onclick='() => OnBuilding.InvokeAsync("legends")'></button>

        <button type="button" class="refuge-town-spot refuge-town-spot--gate"
                data-sound-cue="none" aria-label="@GateLabel" title="Enter the World Gate"
                @onclick="() => OnGate.InvokeAsync()"></button>
    </div>
    @if (showTownMetrics)
    {
        <output id="refuge-town-performance" class="refuge-town-performance"
                data-town-performance="true" aria-label="Refuge performance measurements"></output>
    }
    @if (showTownGeometry)
    {
        <div class="refuge-town-geometry-toolbar" role="group" aria-label="Town debug geometry layers">
            <button type="button" data-town-layer-select="All" aria-pressed="@(geometryLayer == TownGeometryLayer.All ? "true" : "false")"
                    @onclick="() => ShowLayer(TownGeometryLayer.All)">All</button>
            <button type="button" data-town-layer-select="Walkable" aria-pressed="@(geometryLayer == TownGeometryLayer.Walkable ? "true" : "false")"
                    @onclick="() => ShowLayer(TownGeometryLayer.Walkable)">Walk</button>
            <button type="button" data-town-layer-select="Blocked" aria-pressed="@(geometryLayer == TownGeometryLayer.Blocked ? "true" : "false")"
                    @onclick="() => ShowLayer(TownGeometryLayer.Blocked)">Block</button>
            <button type="button" data-town-layer-select="Occlusion" aria-pressed="@(geometryLayer == TownGeometryLayer.Occlusion ? "true" : "false")"
                    @onclick="() => ShowLayer(TownGeometryLayer.Occlusion)">Cover</button>
        </div>
    }
</div>

@code {
    private TownCrowd? crowd;
    private readonly CancellationTokenSource loadingStop = new();

    private bool showTownGeometry;
    private bool showTownMetrics;
    private bool showTownWalkScan;
    private string? walkScanPath;
    private TownGeometryLayer geometryLayer = TownGeometryLayer.All;

    private enum TownGeometryLayer { All, Walkable, Blocked, Occlusion }

    private void ShowLayer(TownGeometryLayer layer) => geometryLayer = layer;

    protected override async Task OnInitializedAsync()
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries);
        showTownGeometry = query.Any(parameter =>
            string.Equals(parameter, "townGeometry=1", StringComparison.OrdinalIgnoreCase));
        showTownMetrics = query.Any(parameter =>
            string.Equals(parameter, "townMetrics=1", StringComparison.OrdinalIgnoreCase));
        showTownWalkScan = query.Any(parameter =>
            string.Equals(parameter, "townWalkScan=1", StringComparison.OrdinalIgnoreCase));
        // Explicit, bounded stress-test override; the normal population is unchanged.
        var countOverride = query.FirstOrDefault(parameter =>
            parameter.StartsWith("townNpcCount=", StringComparison.OrdinalIgnoreCase));
        var citizenCount = countOverride is not null &&
            int.TryParse(countOverride["townNpcCount=".Length..], out var requestedCount) &&
            requestedCount is >= 7 and <= 14 ? requestedCount : 7;

        try
        {
            using var http = new HttpClient();
            var json = await http.GetStringAsync(Navigation.ToAbsoluteUri($"art/town/night-navigation.json?v={AppBuildInfo.Version}"), loadingStop.Token);
            if (loadingStop.IsCancellationRequested) return;
            crowd = new TownCrowd(TownNavigationMap.FromJson(json), seed: 205, citizenCount: citizenCount,
                openBuildings: OpenBuildings());
            if (showTownWalkScan) walkScanPath = crowd.Navigation.DebugWalkabilityScanPath();
        }
        catch (OperationCanceledException) { /* Town was left before navigation loaded. */ }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or ArgumentException)
        {
            Logger.LogWarning(exception, "Refuge navigation unavailable. Leave the painted town intact without pedestrians.");
        }
    }

    protected override void OnParametersSet() => crowd?.SetOpenBuildings(OpenBuildings());

    private IEnumerable<string> OpenBuildings()
    {
        if (NexusUnlocked) yield return "build";
        if (ForgeUnlocked) yield return "forge";
        if (CodexUnlocked) yield return "codex";
        if (HallUnlocked) yield return "legends";
    }

    private void OnGeometryChanged()
    {
        if (showTownWalkScan && crowd is not null)
            walkScanPath = crowd.Navigation.DebugWalkabilityScanPath();
        StateHasChanged();
    }

    private static string GeometryPoints(IReadOnlyList<TownPoint> points) =>
        string.Join(" ", points.Select(point => FormattableString.Invariant($"{point.X:0.##},{point.Y:0.##}")));

    public void Dispose()
    {
        loadingStop.Cancel();
        loadingStop.Dispose();
    }

    [Parameter] public bool NexusUnlocked { get; set; }
    [Parameter] public bool ForgeUnlocked { get; set; }
    [Parameter] public bool CodexUnlocked { get; set; }
    [Parameter] public bool HallUnlocked { get; set; }
    [Parameter] public bool FirstHunt { get; set; }
    [Parameter] public bool NexusPointsAvailable { get; set; }
    [Parameter] public EventCallback OnGate { get; set; }
    [Parameter] public EventCallback<string> OnBuilding { get; set; }

    private string GateLabel => FirstHunt ? "BEGIN FIRST HUNT" : "BEGIN HUNT";

    private static string BuildingLabel(string name, bool unlocked) => unlocked
        ? $"Enter {name}"
        : $"{name} locked. Tap for unlock requirements.";
}
