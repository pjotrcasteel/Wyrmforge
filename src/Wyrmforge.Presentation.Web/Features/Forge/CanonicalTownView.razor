@* Night town vacancy follows actual game progress, not a local preview toggle. *@
<div class="refuge-canonical-viewport" role="region" tabindex="0"
     aria-label="Refuge town: swipe between West, World Gate and East">
    <div class="refuge-canonical-scene" aria-label="Night-time Refuge town square">
        <img class="refuge-town-night-base" src="art/town/night-active.webp?v=132"
             alt="" draggable="false" fetchpriority="high" />

        @if (!NexusUnlocked)
        {
            <img class="refuge-town-vacant-layer" src="art/town/night-vacant-ArcaneNexus.png?v=132"
                 style="left:0%;top:0%;width:36.9617%;height:61.8491%" alt="" draggable="false" />
        }
        @if (!ForgeUnlocked)
        {
            <img class="refuge-town-vacant-layer" src="art/town/night-vacant-Blacksmith.png?v=132"
                 style="left:0%;top:37.5133%;width:37.8589%;height:62.4867%" alt="" draggable="false" />
        }
        @if (!CodexUnlocked)
        {
            <img class="refuge-town-vacant-layer" src="art/town/night-vacant-Codex.png?v=132"
                 style="left:58.7321%;top:0%;width:41.2679%;height:58.2359%" alt="" draggable="false" />
        }
        @if (!HallUnlocked)
        {
            <img class="refuge-town-vacant-layer" src="art/town/night-vacant-HallOfFame.png?v=132"
                 style="left:51.7943%;top:35.3880%;width:48.2057%;height:64.6120%" alt="" draggable="false" />
        }

        <button type="button" class="refuge-town-spot refuge-town-spot--nexus"
                data-town-building="build" data-town-state="@(TownBuildingVisuals.StateName(NexusUnlocked))"
                data-sound-cue="@(NexusUnlocked ? "building-open" : "none")" title="@BuildingLabel("Arcane Nexus", NexusUnlocked)"
                aria-label="@BuildingLabel("Arcane Nexus", NexusUnlocked)" @onclick='() => OnBuilding.InvokeAsync("build")'></button>
        <button type="button" class="refuge-town-spot refuge-town-spot--blacksmith"
                data-town-building="forge" data-town-state="@(TownBuildingVisuals.StateName(ForgeUnlocked))"
                data-sound-cue="@(ForgeUnlocked ? "building-open" : "none")" title="@BuildingLabel("Blacksmith", ForgeUnlocked)"
                aria-label="@BuildingLabel("Blacksmith", ForgeUnlocked)" @onclick='() => OnBuilding.InvokeAsync("forge")'></button>
        <button type="button" class="refuge-town-spot refuge-town-spot--codex"
                data-town-building="codex" data-town-state="@(TownBuildingVisuals.StateName(CodexUnlocked))"
                data-sound-cue="@(CodexUnlocked ? "building-open" : "none")" title="@BuildingLabel("Codex", CodexUnlocked)"
                aria-label="@BuildingLabel("Codex", CodexUnlocked)" @onclick='() => OnBuilding.InvokeAsync("codex")'></button>
        <button type="button" class="refuge-town-spot refuge-town-spot--hall"
                data-town-building="legends" data-town-state="@(TownBuildingVisuals.StateName(HallUnlocked))"
                data-sound-cue="@(HallUnlocked ? "building-open" : "none")" title="@BuildingLabel("Hall of Fame", HallUnlocked)"
                aria-label="@BuildingLabel("Hall of Fame", HallUnlocked)" @onclick='() => OnBuilding.InvokeAsync("legends")'></button>

        <button type="button" class="refuge-town-spot refuge-town-spot--gate"
                data-sound-cue="none" aria-label="@GateLabel" title="Enter the World Gate"
                @onclick="() => OnGate.InvokeAsync()"></button>
    </div>
</div>

@code {
    [Parameter] public bool NexusUnlocked { get; set; }
    [Parameter] public bool ForgeUnlocked { get; set; }
    [Parameter] public bool CodexUnlocked { get; set; }
    [Parameter] public bool HallUnlocked { get; set; }
    [Parameter] public bool FirstHunt { get; set; }
    [Parameter] public bool NexusPointsAvailable { get; set; }
    [Parameter] public EventCallback OnGate { get; set; }
    [Parameter] public EventCallback<string> OnBuilding { get; set; }

    private string GateLabel => FirstHunt ? "BEGIN FIRST HUNT" : "BEGIN HUNT";

    private static string BuildingLabel(string name, bool unlocked) => unlocked
        ? $"Enter {name}"
        : $"{name} locked. Tap for unlock requirements.";
}
