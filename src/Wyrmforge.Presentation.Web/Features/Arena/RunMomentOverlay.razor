@namespace Wyrmforge.Presentation.Web.Features.Arena

<div class="run-moment @(Moment.Compact ? "upgrade-moment" : string.Empty) tone-@Moment.Tone.ToString().ToLowerInvariant()" role="status" aria-live="polite">
    @if (!string.IsNullOrEmpty(Moment.Eyebrow))
    {
        <span>@Moment.Eyebrow</span>
    }
    <strong>@Moment.Title</strong>
    <small>@Moment.Detail</small>
</div>

@code {
    [Parameter, EditorRequired] public RunMoment Moment { get; set; } = null!;
}
