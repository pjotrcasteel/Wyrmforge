<main class="game-screen">
    <canvas @ref="canvas" class="game-canvas" aria-label="Wyrmforge combat arena"></canvas>
    <RealmInfluenceView Influences="CurrentRealmInfluences" />
    <button class="leave-run" title="Retreat — abandon this run" aria-label="Abandon run" @onclick="AbandonRunAsync">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="13.5" cy="4" r="1.8"/>
            <path d="m8 21 3.8-5.2-2-3.5-3.5 1.2M20 21l-4.1-4-1.4-3.5M8.5 7.8l4.2-1 3.2 3 3.4.6M4 10.5l4.4-2.7"/>
        </svg>
        <span class="leave-run-label">RETREAT</span>
    </button>

    @if (runMoment is { } moment)
    {
        <RunMomentOverlay Moment="moment" />
    }

    <div class="arena-top-hud" aria-label="Combat HUD">
        <section class="combat-vitals" aria-label="Player status">
            <div class="combat-vitals-score">
                <span data-hud="score">SCORE 0</span>
                <span data-hud="time">0s</span>
                <span data-hud="kills">0 KILLS</span>
            </div>
            <div class="combat-health-track"><div data-hud="health-fill"></div></div>
            <div class="combat-vitals-progress">
                <span data-hud="health">HP 100/100</span>
                <span data-hud="level">LV 1</span>
                <div class="combat-xp-track"><div data-hud="xp-fill"></div></div>
            </div>
            <div class="combat-vitals-spells" data-hud="spells" aria-label="Equipped spells">◇I</div>
        </section>
        @if (MapCombatActive && CurrentMapNode is { } activeNode)
        {
            <section class="encounter-objective" aria-label="Current encounter objective">
                <span title="@activeNode.Name">TRAIL @activeNode.Stage • @activeNode.Name</span>
                <div class="encounter-objective-progress">
                    <em class="encounter-phase">@EncounterPhaseLabel</em>
                    <strong>@CurrentMapNodeKills / @CurrentMapNodeKillsRequired KILLS</strong>
                </div>
            </section>
        }
        else if (EvacuationActive)
        {
            <section class="encounter-objective evacuation" aria-label="Evacuation countdown">
                <span>EVACUATION</span>
                <strong>@Math.Ceiling(EvacuationRemainingSeconds).ToString("0")s</strong>
            </section>
        }
    </div>

    @if (CurrentEssences.Count > 0 || CurrentRelics.Count > 0 || CurrentDepth > 1 || CurrentOffering is not null)
    {
        <details class="run-state-dock" aria-label="Current run state">
            <summary>
                <b>RUN</b>
                <span>D@CurrentDepth</span>
                @if (PendingEssenceCount > 0)
                {
                    <span class="cargo-pending">◇@PendingEssenceCount</span>
                }
                @if (SecuredEssenceCount > 0)
                {
                    <span class="cargo-secured">✓@SecuredEssenceCount</span>
                }
            </summary>
            <div class="run-state-popover">
                @if (CurrentOffering is not null && RunOffering is { } offeringId)
                {
                    var source = DragonEssenceCatalog.Get(offeringId);
                    <span title="@CurrentOffering.Effect">🔥 OFFERING • @source.Icon @source.Name</span>
                }
                @if (CurrentDepth > 1)
                {
                    <span>DEPTH @CurrentDepth • ×@CurrentScoreMultiplier.ToString("0.0") BASE SCORE</span>
                }
                @if (PendingEssenceCount > 0)
                {
                    <span class="cargo-pending">◇ @PendingEssenceCount ESSENCE AT RISK</span>
                }
                @if (SecuredEssenceCount > 0)
                {
                    <span class="cargo-secured">✓ @SecuredEssenceCount ESSENCE SECURED</span>
                }
                @foreach (var relic in CurrentRelics)
                {
                    <span title="@relic.Description">@relic.Icon @relic.Name</span>
                }
                @foreach (var essence in CurrentEssences)
                {
                    <span title="@essence.Effect">@essence.Icon @essence.Name</span>
                }
            </div>
        </details>
    }

    @if (CurrentEssenceChoices.Count > 0)
    {
        <DragonHarvestOverlay Choices="CurrentEssenceChoices" OnChoose="ChooseEssenceAsync" />
    }
    else if (CurrentRelicChoices.Count > 0)
    {
        <RelicChoiceOverlay Choices="CurrentRelicChoices" OnChoose="ChooseRelicAsync" />
    }
    else if (AtRefuge)
    {
        <RefugeOverlay Actions="CurrentCheckpointActions" Visit="CheckpointVisit" NextDepth="@(CurrentDepth + 1)" ScoreMultiplier="NextDepthScoreMultiplier"
            SecuredEssenceCount="SecuredEssenceCount" Health="CurrentHealth" MaxHealth="CurrentMaxHealth" OwnedRelics="OwnedRelics" EquippedRelics="CurrentRelics"
            RelicSlots="RelicSlots" OnUse="UseCheckpointActionAsync" OnEquipRelic="EquipRelicAsync" OnUnequipRelic="UnequipRelicAsync" />
    }
    else if (CurrentChoices.Count > 0)
    {
        <LevelUpOverlay Level="CurrentLevel + 1" Choices="CurrentChoices" OnChoose="ChooseAsync" />
    }
    else if (PendingMapChoice)
    {
        <WyrmrealmMapView Depth="CurrentDepth" Nodes="MapNodes" AvailableNodes="AvailableMapNodes" CompletedNodes="CompletedMapNodes" Resonance="CurrentResonance"
            Signs="CurrentDragonSigns" OnChoose="ChooseMapNodeAsync" />
    }
</main>
