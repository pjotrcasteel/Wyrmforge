<main class="game-screen">
    <canvas @ref="canvas" class="game-canvas" aria-label="Wyrmforge combat arena"></canvas>
    <RealmInfluenceView Influences="CurrentRealmInfluences" />
    <button class="leave-run" @onclick="AbandonRunAsync">Abandon run</button>

    @if (MapCombatActive && CurrentMapNode is { } activeNode)
    {
        <div class="encounter-objective" aria-label="Current encounter objective">
            <span>TRAIL @activeNode.Stage • @activeNode.Name • @activeNode.AttunementSchool</span>
            <strong>@CurrentMapNodeKills / @CurrentMapNodeKillsRequired KILLS</strong>
        </div>
    }
    else if (EvacuationActive)
    {
        <div class="encounter-objective" aria-label="Evacuation countdown">
            <span>EVACUATION RITUAL • HOLD THE CIRCLE</span>
            <strong>@Math.Ceiling(EvacuationRemainingSeconds).ToString("0")s</strong>
        </div>
    }

    @if (CurrentEssences.Count > 0 || CurrentRelics.Count > 0 || CurrentDepth > 1 || CurrentOffering is not null)
    {
        <div class="essence-strip" aria-label="Current run state">
            @if (CurrentOffering is not null && RunOffering is { } offeringId)
            {
                var source = DragonEssenceCatalog.Get(offeringId);
                <span title="@CurrentOffering.Effect">🔥 OFFERING • @source.Icon @source.Name</span>
            }
            @if (CurrentDepth > 1)
            {
                <span>DEPTH @CurrentDepth • ×@CurrentScoreMultiplier.ToString("0.0") BASE SCORE</span>
            }
            @foreach (var relic in CurrentRelics)
            {
                <span title="@relic.Description">@relic.Icon @relic.Name</span>
            }
            @foreach (var essence in CurrentEssences)
            {
                <span title="@essence.Effect">@essence.Icon @essence.Name</span>
            }
        </div>
    }

    @if (CurrentEssenceChoices.Count > 0)
    {
        <DragonHarvestOverlay Choices="CurrentEssenceChoices" OnChoose="ChooseEssenceAsync" />
    }
    else if (CurrentRelicChoices.Count > 0)
    {
        <RelicChoiceOverlay Choices="CurrentRelicChoices" OnChoose="ChooseRelicAsync" />
    }
    else if (AtRefuge)
    {
        <RefugeOverlay Actions="CurrentCheckpointActions" Visit="CheckpointVisit" NextDepth="@(CurrentDepth + 1)" ScoreMultiplier="NextDepthScoreMultiplier"
            SecuredEssenceCount="SecuredEssenceCount" Health="CurrentHealth" MaxHealth="CurrentMaxHealth" OwnedRelics="OwnedRelics" EquippedRelics="CurrentRelics"
            RelicSlots="RelicSlots" OnUse="UseCheckpointActionAsync" OnEquipRelic="EquipRelicAsync" OnUnequipRelic="UnequipRelicAsync" />
    }
    else if (CurrentChoices.Count > 0)
    {
        <LevelUpOverlay Level="CurrentLevel + 1" Choices="CurrentChoices" OnChoose="ChooseAsync" />
    }
    else if (PendingMapChoice)
    {
        <WyrmrealmMapView Depth="CurrentDepth" Nodes="MapNodes" AvailableNodes="AvailableMapNodes" CompletedNodes="CompletedMapNodes" Resonance="CurrentResonance" Signs="CurrentDragonSigns" OnChoose="ChooseMapNodeAsync" />
    }
</main>
