@page "/"

@if (!runActive)
{
    <ForgeView Selection="selection" Vault="essenceVault" Codex="arcaneCodex" HuntTarget="selectedHuntTarget" SelectedOffering="selectedOffering" BestScore="bestScore" OnHuntTargetChanged="SelectHuntTarget" OnOfferingChanged="SelectOffering" OnStart="StartRunAsync" />
}
else
{
    <ArenaView @key="runNumber" SelectedNodes="selection.Selected" RunOffering="activeOffering" HuntTarget="selectedHuntTarget" OnGameOver="HandleGameOverAsync" />
}

@if (summary is not null)
{
    <RunSummaryOverlay Summary="summary" HuntTarget="selectedHuntTarget" OnReturn="ReturnToForge" />
}
