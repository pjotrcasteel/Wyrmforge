@page "/"

@if (!runActive)
{
    <ForgeView Selection="selection" Vault="essenceVault" Codex="arcaneCodex" SelectedOffering="selectedOffering" BestScore="bestScore" OnOfferingChanged="SelectOffering" OnStart="StartRunAsync" />
}
else
{
    <ArenaView @key="runNumber" SelectedNodes="selection.Selected" RunOffering="activeOffering" OnGameOver="HandleGameOverAsync" />
}

@if (summary is not null)
{
    <RunSummaryOverlay Summary="summary" OnReturn="ReturnToForge" />
}