@page "/arena-materials"
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components

<main class="materials-lab">
    <header>
        <div>
            <span class="eyebrow">WYRMFORGE · ARENA FOUNDATION</span>
            <h1>Ground materials</h1>
            <p>Real ground samples cropped from your Gothic arena reference. Compare and paint them. No arena layout or props.</p>
        </div>
        <a class="other-lab" href="arena-lab">Previous arena lab</a>
    </header>

    <section aria-label="Paint material" class="materials-tools">
        <span class="section-title">PAINT</span>
        <button class="@(selected == 0 ? "selected" : "")" aria-pressed="@(selected == 0)"
                @onclick="() => Pick(0)"><i class="sample grass"></i>Grass</button>
        <button class="@(selected == 1 ? "selected" : "")" aria-pressed="@(selected == 1)"
                @onclick="() => Pick(1)"><i class="sample mud"></i>Wet mud</button>
        <button class="@(selected == 2 ? "selected" : "")" aria-pressed="@(selected == 2)"
                @onclick="() => Pick(2)"><i class="sample paving"></i>Old paving</button>
        <button class="@(selected == 3 ? "selected" : "")" aria-pressed="@(selected == 3)"
                @onclick="() => Pick(3)"><i class="sample dirt"></i>Dirt</button>
        <button class="@(selected == 4 ? "selected" : "")" aria-pressed="@(selected == 4)"
                @onclick="() => Pick(4)"><i class="sample scorched"></i>Scorched</button>
        <button class="@(selected == 5 ? "selected" : "")" aria-pressed="@(selected == 5)"
                @onclick="() => Pick(5)"><i class="sample marsh"></i>Marsh</button>
    </section>

    <section aria-label="Painting controls" class="brush-tools">
        <span>Brush</span>
        <button class="@(brush == 1 ? "selected" : "")" @onclick="() => Size(1)">Small</button>
        <button class="@(brush == 2 ? "selected" : "")" @onclick="() => Size(2)">Medium</button>
        <button class="@(brush == 5 ? "selected" : "")" @onclick="() => Size(5)">Large</button>
        <button class="secondary" @onclick="Undo">Undo</button>
        <button class="secondary" @onclick="Reset">Reset samples</button>
        <button class="secondary" @onclick="Clear">All grass</button>
        <button class="secondary" @onclick="Preview">Natural ground</button>
        <button class="secondary" @onclick="Reroll">Different ground</button>
        <button class="@(fineDetail ? "selected" : "secondary")" aria-pressed="@(fineDetail ? "true" : "false")"
                disabled="@fineDetailBusy" aria-busy="@fineDetailBusy"
                @onclick="ToggleFineDetail">@(fineDetailBusy ? "Applying detail…" : $"Fine detail {(fineDetail ? "On" : "Off")}")</button>
    </section>

    @if (fineDetailError is not null)
    {
        <p role="alert" class="material-detail-error">@fineDetailError</p>
    }

    <section class="material-workspace" aria-label="Editable pixel ground material samples">
        <div class="canvas-wrap">
            <canvas @ref="canvas" width="480" height="640"
                    aria-label="Editable ground comparison board. Starting with rows of grass, mud, paving, dirt, scorched soil and marsh. Drag to paint with the selected material."></canvas>
        </div>
        <aside>
            <h2>Material samples</h2>
            <p>Top to bottom: grass, wet mud, old paving, dirt, scorched ground, marsh.</p>
            <p>Paint any surface, or tap Natural ground to see large connected patches without structures or roads. Repaint or undo freely.</p>
            <p>Stone paving and scorched earth stay brush-only until road and fire-area design.</p>
            <p>Fine detail is optional: compare small clustered marks sampled from the same approved painted ground. The original materials stay unchanged when switched off.</p>
            <p class="detail">Reference image material study · No gameplay collision</p>
        </aside>
    </section>
</main>

@code {
    [Inject] private IJSRuntime JS { get; set; } = null!;
    private ElementReference canvas;
    private IJSObjectReference? module;
    private int selected;
    private int brush = 2;
    private int seed = 1441;
    private int previewSeed = 1441;
    private bool fineDetail;
    private bool fineDetailBusy;
    private string? fineDetailError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // The page assembly and JS renderer must change together on iPhone Safari.
        // Keep a versioned module URL to avoid serving stale functions from its module cache.
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/arena-materials.js?v=20261022-fine-pixels-1");
        await module.InvokeVoidAsync("initMaterialsLab", canvas, seed);
    }

    private async Task Pick(int next)
    {
        selected = next;
        if (module is not null) await module.InvokeVoidAsync("selectGroundMaterial", canvas, next);
    }

    private async Task Size(int next)
    {
        brush = next;
        if (module is not null) await module.InvokeVoidAsync("selectGroundBrush", canvas, next);
    }

    private async Task Undo()
    {
        if (module is not null) await module.InvokeVoidAsync("undoMaterialStroke", canvas);
    }

    private async Task Reset()
    {
        if (module is not null) await module.InvokeVoidAsync("resetMaterialSamples", canvas);
    }

    private async Task Clear()
    {
        if (module is not null) await module.InvokeVoidAsync("clearMaterialSamples", canvas);
    }

    private async Task Preview()
    {
        if (module is not null) await module.InvokeVoidAsync("previewNaturalGround", canvas, previewSeed);
    }

    private async Task Reroll()
    {
        previewSeed++;
        await Preview();
    }

    private async Task ToggleFineDetail()
    {
        if (module is null || fineDetailBusy) return;
        fineDetailBusy = true;
        fineDetailError = null;
        try
        {
            // Do not claim On unless the loaded renderer has baked the updated atlas.
            var next = !fineDetail;
            if (await module.InvokeAsync<bool>("setGroundFineDetail", canvas, next))
                fineDetail = next;
            else
                fineDetailError = "The material artwork is still loading. Try again.";
        }
        catch (JSException)
        {
            fineDetailError = "The ground renderer could not switch details. Reload this page.";
        }
        finally
        {
            fineDetailBusy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync("disposeMaterialsLab", canvas); }
        catch (JSDisconnectedException) { }
        try { await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
