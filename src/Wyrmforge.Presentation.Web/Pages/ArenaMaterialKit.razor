@page "/arena-material-kit"
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using Wyrmforge.Application.Runs.Simulation
@inject IJSRuntime JavaScript
@inject NavigationManager Navigation

<main class="arena-kit">
    <header>
        <span class="eyebrow">WYRMFORGE / WET FOREST / MATERIAL KIT</span>
        <h1>Three materials. One real terrain recipe.</h1>
        <p>Grass/Moss, Trampled Earth and Wet Mud from our existing Wet Forest source-art workstream.
            The original paintings and source-backed candidate variants are used with the shared GPU lighting engine;
            the C# terrain recipe, road and collision rules remain unchanged.</p>
    </header>

    <section class="kit-controls" aria-label="Material scene controls">
        <label>World seed
            <input type="number" aria-label="World seed" @bind="seed" />
        </label>
        <button type="button" @onclick="Generate">Generate C# terrain</button>
        <button type="button" @onclick="NextSeed">Another seed</button>
        <label>Ground artwork
            <select aria-label="Ground artwork" @bind="artSource" @bind:after="Sync">
                <option value="source-backed">Existing PR #340 textures (unapproved)</option>
                <option value="original">Existing six-swatch game atlas (A/B)</option>
            </select>
        </label>
        <label>Existing texture variation
            <select aria-label="Existing texture variation" @bind="artVariant" @bind:after="Sync"
                    disabled="@(artSource == "original")">
                <option value="1">Variation 01</option>
                <option value="2">Variation 02</option>
                <option value="3">Variation 03</option>
                <option value="4">Variation 04</option>
                <option value="5">Variation 05</option>
                <option value="6">Variation 06</option>
            </select>
        </label>
        <label>Ground boundaries
            <select aria-label="Ground boundaries" @bind="boundaryKind" @bind:after="Sync"
                    disabled="@(artSource == "original")">
                <option value="organic">Continuous organic contacts</option>
                <option value="original">Previous stepped contacts (compare)</option>
            </select>
        </label>
        <label>GPU lighting
            <select aria-label="GPU lighting" @bind="lighting" @bind:after="Sync">
                <option value="night">Gothic night</option>
                <option value="neutral">Neutral inspection</option>
                <option value="zero">Zero light (black-world test)</option>
            </select>
        </label>
    </section>

    @if (error is not null) { <p role="alert">@error</p> }
    <section class="kit-layout">
        <div class="kit-stage">
            <canvas @ref="canvas" aria-label="Three-material Wet Forest generated by C# and lit by shared GPU"></canvas>
            <span class="kit-overlay">GPU / C# WORLD RECIPE / ART REVIEW</span>
        </div>
        <aside class="kit-inspector">
            <h2>Material library</h2>
            <dl>
                <dt>Grass / Moss</dt><dd>Continuous forest base</dd>
                <dt>Trampled Earth</dt><dd>Existing C# trail and clearings</dd>
                <dt>Wet Mud</dt><dd>Existing ground patches, including provisional puddle color</dd>
                <dt>World recipe</dt><dd>@nameof(HuntArenaGenerator.GenerateWetForest)</dd>
                <dt>Seed</dt><dd>@seed</dd>
                <dt>Road geometry changes</dt><dd>None</dd>
                <dt>Collisions/gameplay changes</dt><dd>None</dd>
                <dt>Art materials</dt><dd>@(artSource == "source-backed" ? "Three existing 900px source-backed art studies (variation " + artVariant + ", unapproved)" : "Existing painted runtime atlas (reference)")</dd>
                <dt>GPU surface response</dt><dd>3 provisional region-specific roughness values, one shared non-color map</dd>
            </dl>
            <h3>Acceptance</h3>
            <p>All PR #340 candidates remain under visual review: source highlights and repeated painted details
                are not yet light-neutral production material channels. This preview shows the ACTUAL existing texture
                artwork in the C# seeded GPU scene—not new drawings or fictional roads/water.</p>
            <p>The boundary selector compares continuous source-pixel contours against the former stepped joins
                without changing terrain, material art or world lighting. No painted image was altered.</p>
            <p>Compare all six already-created variations under identical scene lighting. Keep all originals
                immutable until material-channel work and actual 320px/390px scene approval.</p>
            <p><a href="/arena-light-engine">Shared GPU engine proof</a> ·
               <a href="/arena-lab">Existing ground lab</a></p>
        </aside>
    </section>
</main>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "seed")] public string? RequestedSeed { get; set; }
    private ElementReference canvas;
    private IJSObjectReference? module;
    private HuntArenaGenerator.WetForestRecipe? recipe;
    private int seed = 1204;
    private string lighting = "night";
    private string artSource = "source-backed";
    private int artVariant = 1;
    private string boundaryKind = "organic";
    private string? error;

    protected override void OnParametersSet()
    {
        if (int.TryParse(RequestedSeed, System.Globalization.NumberStyles.Integer,
                System.Globalization.CultureInfo.InvariantCulture, out var candidate))
            seed = candidate;
        recipe = HuntArenaGenerator.GenerateWetForest(seed);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JavaScript.InvokeAsync<IJSObjectReference>(
                "import", "./js/wet-forest-gpu-material-review.js");
            await module.InvokeVoidAsync("initializeThreeMaterialReview", canvas, recipe, seed, lighting, artSource, artVariant, boundaryKind);
        }
        catch (JSException exception) { error = exception.Message; StateHasChanged(); }
    }

    private async Task Generate()
    {
        recipe = HuntArenaGenerator.GenerateWetForest(seed);
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("seed", seed), replace: true);
        await Sync();
    }

    private async Task NextSeed()
    {
        seed = unchecked(seed + 1);
        await Generate();
    }

    private async Task Sync()
    {
        if (module is null) return;
        try
        {
            recipe ??= HuntArenaGenerator.GenerateWetForest(seed);
            await module.InvokeVoidAsync("configureThreeMaterialReview", canvas, recipe, seed, lighting, artSource, artVariant, boundaryKind);
        }
        catch (JSException exception) { error = exception.Message; }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync("disposeThreeMaterialReview", canvas); }
        catch (JSDisconnectedException) { }
        await module.DisposeAsync();
    }
}
