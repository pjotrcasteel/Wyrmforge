@page "/arena-material-kit"
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using Wyrmforge.Application.Runs.Simulation
@inject IJSRuntime JavaScript
@inject NavigationManager Navigation

<main class="arena-kit">
    <header>
        <span class="eyebrow">WYRMFORGE / WET FOREST / MATERIAL KIT</span>
        <h1>Three materials. One real terrain recipe.</h1>
        <p>Grass/Moss, Trampled Earth and Wet Mud rendered through the existing shared GPU lighting engine.
            Trail, clearing and wet-ground locations are generated by the C# HuntArenaGenerator.
            This is a scene integration preview, not a new world generator or a live Hunt.</p>
    </header>

    <section class="kit-controls" aria-label="Material scene controls">
        <label>World seed
            <input type="number" aria-label="World seed" @bind="seed" />
        </label>
        <button type="button" @onclick="Generate">Generate C# terrain</button>
        <button type="button" @onclick="NextSeed">Another seed</button>
        <label>GPU lighting
            <select aria-label="GPU lighting" @bind="lighting" @bind:after="Sync">
                <option value="night">Gothic night</option>
                <option value="neutral">Neutral inspection</option>
                <option value="zero">Zero light (black-world test)</option>
            </select>
        </label>
    </section>

    @if (error is not null) { <p role="alert">@error</p> }
    <section class="kit-layout">
        <div class="kit-stage">
            <canvas @ref="canvas" aria-label="Three-material Wet Forest generated by C# and lit by shared GPU"></canvas>
            <span class="kit-overlay">GPU / C# WORLD RECIPE / ART REVIEW</span>
        </div>
        <aside class="kit-inspector">
            <h2>Material library</h2>
            <dl>
                <dt>Grass / Moss</dt><dd>Continuous forest base</dd>
                <dt>Trampled Earth</dt><dd>Existing C# trail and clearings</dd>
                <dt>Wet Mud</dt><dd>Existing ground patches, including provisional puddle color</dd>
                <dt>World recipe</dt><dd>@nameof(HuntArenaGenerator.GenerateWetForest)</dd>
                <dt>Seed</dt><dd>@seed</dd>
                <dt>Road geometry changes</dt><dd>None</dd>
                <dt>Collisions/gameplay changes</dt><dd>None</dd>
                <dt>Art materials</dt><dd>3 existing approved painted swatches (provisional)</dd>
            </dl>
            <h3>Acceptance</h3>
            <p>The original swatches still contain painted highlights. This preview proves semantic material
                selection and shared GPU lighting, <strong>not</strong> production-neutral albedo, normal maps,
                true water, or native phone performance.</p>
            <p>Next: author compact light-neutral replacement swatches and decals, then compare their
                actual scene appearance here before approving any live Hunt integration.</p>
            <p><a href="/arena-light-engine">Shared GPU engine proof</a> ·
               <a href="/arena-lab">Existing ground lab</a></p>
        </aside>
    </section>
</main>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "seed")] public string? RequestedSeed { get; set; }
    private ElementReference canvas;
    private IJSObjectReference? module;
    private HuntArenaGenerator.WetForestRecipe? recipe;
    private int seed = 1204;
    private string lighting = "night";
    private string? error;

    protected override void OnParametersSet()
    {
        if (int.TryParse(RequestedSeed, System.Globalization.NumberStyles.Integer,
                System.Globalization.CultureInfo.InvariantCulture, out var candidate))
            seed = candidate;
        recipe = HuntArenaGenerator.GenerateWetForest(seed);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JavaScript.InvokeAsync<IJSObjectReference>(
                "import", "./js/wet-forest-gpu-material-review.js");
            await module.InvokeVoidAsync("initializeThreeMaterialReview", canvas, recipe, seed, lighting);
        }
        catch (JSException exception) { error = exception.Message; StateHasChanged(); }
    }

    private async Task Generate()
    {
        recipe = HuntArenaGenerator.GenerateWetForest(seed);
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("seed", seed), replace: true);
        await Sync();
    }

    private async Task NextSeed()
    {
        seed = unchecked(seed + 1);
        await Generate();
    }

    private async Task Sync()
    {
        if (module is null) return;
        try
        {
            recipe ??= HuntArenaGenerator.GenerateWetForest(seed);
            await module.InvokeVoidAsync("configureThreeMaterialReview", canvas, recipe, seed, lighting);
        }
        catch (JSException exception) { error = exception.Message; }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync("disposeThreeMaterialReview", canvas); }
        catch (JSDisconnectedException) { }
        await module.DisposeAsync();
    }
}
