@page "/arena-light-engine"
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IJSRuntime JavaScript

<main class="gpu-proof">
    <h1>Shared light engine</h1>
    <p>G0–G1 isolated GPU proof. Town and Hunts are unchanged. Original oak geometry and exported walk-pose normals are under review. Production adoption remains pending.</p>
    <nav aria-label="Light inspection">
        <label>Camera <select @bind="focus" @bind:after="Sync"><option>overview</option><option>actors</option><option>oak</option><option>town</option><option>water</option></select></label>
        <label>Diagnostic <select @bind="view" @bind:after="Sync"><option>lit</option><option>albedo</option><option>normals</option><option>geometry</option><option value="shadow-visibility">Point shadow visibility</option><option value="light-depth">Light depth atlas</option><option value="light-bounds">Light bounds</option></select></label>
        <label>Environment <select @bind="profile" @bind:after="Sync"><option>night</option><option>day</option><option>auto</option><option>zero</option></select></label>
        <label><input type="checkbox" @bind="fireball" @bind:after="Sync" /> Fireball</label>
        <label><input type="checkbox" @bind="torch" @bind:after="Sync" /> Torch</label>
        <label><input type="checkbox" @bind="spot" @bind:after="Sync" /> Spot</label>
        <label><input type="checkbox" @bind="rune" @bind:after="Sync" /> Register rune</label>
        <label><input type="checkbox" @bind="shadows" @bind:after="Sync" /> Shadows</label>
        <label><input type="checkbox" @bind="reflections" @bind:after="Sync" /> Direct specular</label>
        <label>Light position <input type="range" min="0" max="100" @bind="progress" @bind:event="oninput" @bind:after="Sync" /></label>
        <label><input type="checkbox" @bind="animate" @bind:after="Sync" /> Animate walk</label>
        <label><input type="checkbox" @bind="normals" @bind:after="Sync" /> Authored normals</label>
        <label>Inspect object <select @bind="inspectObject" @bind:after="Sync"><option>hollowed</option><option>ashling</option><option>npc-binding-proxy</option><option>roof</option><option>foreground-post</option><option>rock</option></select></label>
        <label><input type="checkbox" @bind="castsShadow" @bind:after="Sync" /> Casts shadow</label>
        <label><input type="checkbox" @bind="receivesShadow" @bind:after="Sync" /> Receives shadow</label>
        <label><input type="checkbox" @bind="receivesLight" @bind:after="Sync" /> Receives light</label>
        <label>Walk frame <input type="range" min="0" max="15" @bind="frame" @bind:event="oninput" @bind:after="Sync" /></label>
    </nav>
    @if (error is not null) { <p role="alert">@error</p> }
    <canvas @ref="canvas" aria-label="Shared GPU world lighting proof"></canvas>
    <details><summary>Emitter registry and GPU diagnostics</summary><pre>@diagnostics</pre></details>
    <p>Screen-space readability remains visible even with all world light and emission off. The Town corner is diagnostic geometry, not replacement Town artwork.</p>
</main>

@code {
    private ElementReference canvas;
    private IJSObjectReference? module;
    private string focus = "overview", inspectObject = "hollowed", diagnostics = "";
    private bool normals = true, castsShadow = true, receivesShadow = true, receivesLight = true;
    private string view = "lit";
    private string profile = "night";
    private string? error;
    private bool fireball = true, torch = true, spot = true, rune, shadows = true, reflections = true;
    private bool animate;
    private int progress = 25, frame;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/lighting/proof-scene.js");
            await module.InvokeVoidAsync("initializeProof", canvas);
            await ReadDiagnostics();
            StateHasChanged();
        }
        catch (JSException exception) { error = exception.Message; StateHasChanged(); }
    }
    private async Task Sync()
    {
        if (module is not null) await module.InvokeVoidAsync("configureProof", canvas,
            new { profile, view, focus, inspectObject, normals, castsShadow, receivesShadow, receivesLight, animate, fireball, torch, spot, rune, shadows, reflections, progress = progress / 100.0, frame });
        await ReadDiagnostics();
    }
    private async Task ReadDiagnostics()
    {
        if (module is not null) diagnostics = System.Text.Json.JsonSerializer.Serialize(
            await module.InvokeAsync<System.Text.Json.JsonElement>("proofDiagnostics", canvas),
            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    }
    public async ValueTask DisposeAsync()
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync("disposeProof", canvas); }
        catch (JSDisconnectedException) { }
        await module.DisposeAsync();
    }
}
