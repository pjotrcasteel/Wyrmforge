rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /hunterBackups/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validBackup() {
        let data = request.resource.data;
        return data.keys().hasOnly(['revision', 'payload'])
          && data.revision is int
          && data.payload is string
          && data.payload.size() > 0
          && data.payload.size() <= 600000;
      }

      allow get: if owner();
      allow create: if owner() && validBackup() && request.resource.data.revision == 1;
      allow update: if owner() && validBackup() && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
